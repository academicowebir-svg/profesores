<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asistencias - Sistema Academico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="/js/asistencias.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-primary text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-clipboard-check me-2"></i>Asistencia - Periodo: 2026-2027</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menú</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">
                <!-- Card de seleccion -->
                <div class="card mb-3">
                    <div class="card-header"><i class="fas fa-cog me-1"></i>Configurar Asistencia por Semana</div>
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label">Seleccionar Curso *</label>
                                <select class="form-select" id="grupo_asistencia" onchange="cargarEstudiantesAsistencia()">
                                    <option value="">Seleccionar curso...</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Semana a partir de *</label>
                                <input type="text" class="form-control" id="fecha_semana" placeholder="Seleccionar fecha" readonly>
                            </div>
                            <div class="col-md-5 d-flex gap-2">
                                <button class="btn btn-success" id="btnGuardarSemana" onclick="guardarAsistenciaSemana()" style="display: none;">
                                    <i class="fas fa-save"></i> Guardar Asistencia de la Semana
                                </button>
                                <button class="btn btn-info" onclick="cargarHistorialAsistencia()">
                                    <i class="fas fa-search"></i> Buscar por Estudiante
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla de asistencia por semana -->
                <div class="card mb-3" id="tablaAsistenciaSemana" style="display: none;">
                    <div class="card-header">Estudiantes del Curso - Semana del <span id="fechaSemanaMostrar"></span></div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm">
                                <thead class="table-light">
                                <tr id="diaHeaders">
                                    <th>Cedula</th>
                                    <th>Nombres</th>
                                </tr>
                                </thead>
                                <tbody id="tablaAsistenciaEstudiantes">
                                </tbody>
                            </table>
                        </div>
                            <div class="alert alert-info mt-2">
                                <i class="fas fa-info-circle me-1"></i>
                                <strong>Legenda:</strong> 
                                <span class="badge bg-danger"><i class="fas fa-times"></i> Falta (checkbox marcado)</span>
                                <span class="badge bg-success ms-2"><i class="fas fa-check"></i> Asistencia (checkbox sin marcar)</span>
                                <small class="text-muted d-block mt-1">Marque el checkbox si el estudiante FALTA. Deje sin marcar si ASISTIÓ.</small>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>Periodo Lectivo:</strong> Agosto 1, 2026 - Julio 31, 2027
                </div>
            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <!-- Modal Buscar por Estudiante -->
    <div class="modal fade" id="modalHistorial" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="fas fa-user-search me-2"></i>Buscar Asistencia por Estudiante</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Cedula o Nombre del Estudiante</label>
                            <input type="text" class="form-control" id="historial_busqueda" placeholder="Ingrese cedula o nombre">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary" onclick="buscarPorEstudiante()">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                    </div>
                    <div id="resultadoEstudiante" style="display: none;">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Materia</th>
                                        <th>Curso</th>
                                        <th>Cedula</th>
                                        <th>Estudiante</th>
                                        <th>Fecha</th>
                                        <th>Dia</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaHistorialAsistencia">
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div id="sinResultado" style="display: none;">
                        <div class="alert alert-warning text-center">No se encontraron registros para esta busqueda</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>