<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reportes - Sistema Academico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="/js/reportes.js?v=4" defer></script>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-primary text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-file-alt me-2"></i>Reportes</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menú</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">
                <ul class="nav nav-tabs mb-3" id="reportesTabs">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabAsistencia">Asistencia</button>
                    </li>
                    <% if (user.rol !== 'inspector') { %>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabNotas">Notas por Trimestre</button>
                    </li>
                    <% } %>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabComentarios">Comentarios</button>
                    </li>
                    <% if (user.rol !== 'inspector') { %>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabWhatsApp">Mensajes WhatsApp Enviados</button>
                    </li>
                    <% } %>
                </ul>

                <div class="tab-content">
                    <!-- ==================== ASISTENCIA ==================== -->
                    <div class="tab-pane fade show active" id="tabAsistencia">
                        <ul class="nav nav-pills mb-3">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#asisCurso" onclick="cambiarTipoAsistencia('curso')">Por Curso</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="pill" data-bs-target="#asisEstudiante" onclick="cambiarTipoAsistencia('estudiante')">Por Estudiante</button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <!-- Asistencia por Materia -->
                            <div class="tab-pane fade show active" id="asisCurso">
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-3">
                                                <label class="form-label">Materia</label>
                                                <select class="form-select" id="asisMateriaSelect">
                                                    <option value="">Seleccionar...</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Fecha Inicio</label>
                                                <input type="date" class="form-control" id="asisFechaInicioCurso">
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Fecha Fin</label>
                                                <input type="date" class="form-control" id="asisFechaFinCurso">
                                            </div>
                                            <div class="col-md-2">
                                                <button class="btn btn-primary w-100" onclick="generarReporteAsistenciaMateria()">
                                                    <i class="fas fa-search me-1"></i> Generar
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-success flex-fill" onclick="exportarExcel('tablaAsistenciaCurso')">
                                                        <i class="fas fa-file-excel me-1"></i> Excel
                                                    </button>
                                                    <button class="btn btn-danger flex-fill" onclick="exportarPDFConDocente('tablaAsistenciaCurso', 'Reporte de Asistencia por Materia')">
                                                        <i class="fas fa-file-pdf me-1"></i> PDF
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover" id="tablaAsistenciaCurso">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>Fecha</th>
                                                <th>Estudiante</th>
                                                <th>Materia</th>
                                                <th>Clases</th>
                                                <th>Asistencias</th>
                                                <th>Ausencias</th>
                                                <th>% Asistencia</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Asistencia por Estudiante -->
                            <div class="tab-pane fade" id="asisEstudiante">
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label">Buscar Estudiante</label>
                                                <input type="text" class="form-control" id="asisBusquedaEstudiante" placeholder="Escriba nombre o cedula..." autocomplete="off" oninput="buscarEstudianteReporte(this, 'asisEstudianteSeleccionado')">
                                                <input type="hidden" id="asisEstudianteSeleccionado">
                                                <div id="asisListaEstudiantes" class="list-group position-absolute" style="z-index:10; display:none; max-height:200px; overflow-y:auto;"></div>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Fecha Inicio</label>
                                                <input type="date" class="form-control" id="asisFechaInicioEst">
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Fecha Fin</label>
                                                <input type="date" class="form-control" id="asisFechaFinEst">
                                            </div>
                                            <div class="col-md-2">
                                                <button class="btn btn-primary w-100" onclick="generarReporteAsistenciaEstudiante()">
                                                    <i class="fas fa-search me-1"></i> Generar
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-success flex-fill" onclick="exportarExcel('tablaAsistenciaEstudiante')">
                                                        <i class="fas fa-file-excel me-1"></i> Excel
                                                    </button>
                                                    <button class="btn btn-danger flex-fill" onclick="exportarPDF('tablaAsistenciaEstudiante', 'Reporte de Asistencia por Estudiante')">
                                                        <i class="fas fa-file-pdf me-1"></i> PDF
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover" id="tablaAsistenciaEstudiante">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>Materia</th>
                                                <th>Materia</th>
                                                <th>Fecha</th>
                                                <th>Estado</th>
                                                <th>Comentario</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ==================== NOTAS ==================== -->
                    <% if (user.rol !== 'inspector') { %>
                    <div class="tab-pane fade" id="tabNotas">
                        <ul class="nav nav-pills mb-3">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#notasCurso" onclick="cambiarTipoNotas('curso')">Por Curso</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="pill" data-bs-target="#notasEstudiante" onclick="cambiarTipoNotas('estudiante')">Por Estudiante</button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <!-- Notas por Materia -->
                            <div class="tab-pane fade show active" id="notasCurso">
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-3">
                                                <label class="form-label">Materia</label>
                                                <select class="form-select" id="notasMateriaSelect">
                                                    <option value="">Seleccionar...</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Trimestre</label>
                                                <select class="form-select" id="notasTrimestreCurso">
                                                    <option value="1">1er Trimestre</option>
                                                    <option value="2">2do Trimestre</option>
                                                    <option value="3">3er Trimestre</option>
                                                    <option value="final">Promedio Final</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <button class="btn btn-primary w-100" onclick="generarReporteNotasMateria()">
                                                    <i class="fas fa-search me-1"></i> Generar
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-success flex-fill" onclick="exportarExcel('tablaNotasCurso')">
                                                        <i class="fas fa-file-excel me-1"></i> Excel
                                                    </button>
                                                    <button class="btn btn-danger flex-fill" onclick="exportarPDFNotasMateria()">
                                                        <i class="fas fa-file-pdf me-1"></i> PDF
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover" id="tablaNotasCurso">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>Estudiante</th>
                                                <th>Prom. Clase</th>
                                                <th>(%)</th>
                                                <th>Proyecto Final</th>
                                                <th>(%)</th>
                                                <th>Examen Final</th>
                                                <th>(%)</th>
                                                <th>Nota Final</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Notas por Estudiante -->
                            <div class="tab-pane fade" id="notasEstudiante">
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label">Buscar Estudiante</label>
                                                <input type="text" class="form-control" id="notasBusquedaEstudiante" placeholder="Escriba nombre o cedula..." autocomplete="off" oninput="buscarEstudianteReporte(this, 'notasEstudianteSeleccionado')">
                                                <input type="hidden" id="notasEstudianteSeleccionado">
                                                <div id="notasListaEstudiantes" class="list-group position-absolute" style="z-index:10; display:none; max-height:200px; overflow-y:auto;"></div>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Trimestre</label>
                                                <select class="form-select" id="notasTrimestreEst">
                                                    <option value="1">1er Trimestre</option>
                                                    <option value="2">2do Trimestre</option>
                                                    <option value="3">3er Trimestre</option>
                                                    <option value="final">Promedio Final</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <button class="btn btn-primary w-100" onclick="generarReporteNotasEstudiante()">
                                                    <i class="fas fa-search me-1"></i> Generar
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-success flex-fill" onclick="exportarExcel('tablaNotasEstudiante')">
                                                        <i class="fas fa-file-excel me-1"></i> Excel
                                                    </button>
                                                    <button class="btn btn-danger flex-fill" onclick="exportarPDF('tablaNotasEstudiante', 'Reporte de Notas por Estudiante')">
                                                        <i class="fas fa-file-pdf me-1"></i> PDF
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover" id="tablaNotasEstudiante">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>Materia</th>
                                                <th>Materia</th>
                                                <th>Tareas</th>
                                                <th>Proy. Nota</th>
                                                <th>Proy. DR</th>
                                                <th>Proy. PR</th>
                                                <th>Exa. Nota</th>
                                                <th>Exa. DRE</th>
                                                <th>Exa. ER</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- ==================== COMENTARIOS ==================== -->
                    <div class="tab-pane fade" id="tabComentarios">
                        <ul class="nav nav-pills mb-3">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#comentMateria" onclick="cambiarTipoComentarios('materia')">Por Materia</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="pill" data-bs-target="#comentEstudiante" onclick="cambiarTipoComentarios('estudiante')">Por Estudiante</button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <!-- Comentarios por Materia -->
                            <div class="tab-pane fade show active" id="comentMateria">
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-3">
                                                <label class="form-label">Materia</label>
                                                <select class="form-select" id="comentMateriaSelect">
                                                    <option value="">Seleccionar...</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Fecha Inicio</label>
                                                <input type="date" class="form-control" id="comentFechaInicio">
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Fecha Fin</label>
                                                <input type="date" class="form-control" id="comentFechaFin">
                                            </div>
                                            <div class="col-md-2">
                                                <button class="btn btn-primary w-100" onclick="generarReporteComentariosMateria()">
                                                    <i class="fas fa-search me-1"></i> Generar
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-success flex-fill" onclick="exportarExcel('tablaComentariosMateria')">
                                                        <i class="fas fa-file-excel me-1"></i> Excel
                                                    </button>
                                                    <button class="btn btn-danger flex-fill" onclick="exportarPDFConDocente('tablaComentariosMateria', 'Reporte de Comentarios por Materia')">
                                                        <i class="fas fa-file-pdf me-1"></i> PDF
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover" id="tablaComentariosMateria">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>Fecha</th>
                                                <th>Estudiante</th>
                                                <th>Origen</th>
                                                <th>Comentario</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Comentarios por Estudiante -->
                            <div class="tab-pane fade" id="comentEstudiante">
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label">Buscar Estudiante</label>
                                                <input type="text" class="form-control" id="comentBusquedaEstudiante" placeholder="Escriba nombre o cedula..." autocomplete="off" oninput="buscarEstudianteReporte(this, 'comentEstudianteSeleccionado')">
                                                <input type="hidden" id="comentEstudianteSeleccionado">
                                                <div id="comentListaEstudiantes" class="list-group position-absolute" style="z-index:10; display:none; max-height:200px; overflow-y:auto;"></div>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Fecha Inicio</label>
                                                <input type="date" class="form-control" id="comentFechaInicioEst">
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Fecha Fin</label>
                                                <input type="date" class="form-control" id="comentFechaFinEst">
                                            </div>
                                            <div class="col-md-2">
                                                <button class="btn btn-primary w-100" onclick="generarReporteComentariosEstudiante()">
                                                    <i class="fas fa-search me-1"></i> Generar
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-success flex-fill" onclick="exportarExcel('tablaComentariosEstudiante')">
                                                        <i class="fas fa-file-excel me-1"></i> Excel
                                                    </button>
                                                    <button class="btn btn-danger flex-fill" onclick="exportarPDF('tablaComentariosEstudiante', 'Reporte de Comentarios por Estudiante')">
                                                        <i class="fas fa-file-pdf me-1"></i> PDF
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover" id="tablaComentariosEstudiante">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>Fecha</th>
                                                <th>Materia</th>
                                                <th>Materia</th>
                                                <th>Origen</th>
                                                <th>Comentario</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ==================== MENSAJES WHATSAPP ==================== -->
                    <% if (user.rol !== 'inspector') { %>
                    <div class="tab-pane fade" id="tabWhatsApp">
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-2">
                                        <label class="form-label">Fecha Inicio</label>
                                        <input type="date" class="form-control" id="whatsappFechaInicio">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Fecha Fin</label>
                                        <input type="date" class="form-control" id="whatsappFechaFin">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Tipo</label>
                                        <select class="form-select" id="whatsappTipoFiltro">
                                            <option value="">Todos</option>
                                            <option value="inasistencia">Inasistencia</option>
                                            <option value="rendimiento">Bajo Rendimiento</option>
                                            <option value="general">General</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Materia</label>
                                        <select class="form-select" id="whatsappMateriaFiltro">
                                            <option value="">Todas</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Buscar</label>
                                        <input type="text" class="form-control" id="whatsappBusqueda" placeholder="Estudiante, grupo...">
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-primary w-100" onclick="cargarHistorialWhatsApp()">
                                            <i class="fas fa-search me-1"></i> Generar
                                        </button>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-success flex-fill" onclick="exportarExcel('tablaHistorialWhatsApp')">
                                                <i class="fas fa-file-excel me-1"></i> Excel
                                            </button>
                                                    <button class="btn btn-danger flex-fill" onclick="exportarPDFConDocente('tablaHistorialWhatsApp', 'Historial de Mensajes WhatsApp')">
                                                        <i class="fas fa-file-pdf me-1"></i> PDF
                                                    </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="tablaHistorialWhatsApp">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Fecha</th>
                                        <th>Hora</th>
                                        <th>Estudiante</th>
                                        <th>Representante</th>
                                        <th>Teléfono</th>
                                        <th>Materia</th>
                                        <th>Tipo</th>
                                        <th>Profesor</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyHistorialWhatsApp"></tbody>
                            </table>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <script>
        function exportarExcel(tablaId) {
            const tabla = document.getElementById(tablaId);
            const wb = XLSX.utils.table_to_book(tabla, {sheet: "Reporte"});
            XLSX.writeFile(wb, tablaId + ".xlsx");
        }
    </script>
</body>
</html>
