<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Justificaciones - Sistema Academico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><img src="/images/sucua2.png" alt="Logo" style="width:40px; height:40px; border-radius:50%; margin-right:8px;">Sistema Academico</a>
            <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home me-1"></i>Menu Principal</a>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="fas fa-clipboard-check me-2"></i>Justificaciones de Inasistencia</h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-5">
                        <label class="form-label fw-bold">Buscar Estudiante</label>
                        <input type="text" class="form-control" id="busquedaEstudiante" placeholder="Cedula o nombre..." autocomplete="off">
                        <div id="listaEstudiantes" class="list-group position-absolute" style="z-index:10; display:none; max-height:250px; overflow-y:auto;"></div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Fecha de Falta</label>
                        <input type="date" class="form-control" id="fechaFalta">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-info w-100" onclick="buscarFaltas()">
                            <i class="fas fa-search me-1"></i>Buscar Faltas
                        </button>
                    </div>
                </div>

                <div id="infoEstudiante" class="alert alert-secondary d-none"></div>

                <div id="seccionFaltas" class="d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="fas fa-user-times me-2 text-danger"></i>Faltas del dia</h5>
                        <button class="btn btn-warning" id="btnJustificarDia" style="display:none" onclick="abrirModalJustificarDia()">
                            <i class="fas fa-check-double me-1"></i>Justificar todo el dia
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="tablaFaltas">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Materia</th>
                                    <th>Curso</th>
                                    <th>Grupo</th>
                                    <th>Estado</th>
                                    <th>Comentario</th>
                                    <th>Estado Justificacion</th>
                                    <th>Accion</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyFaltas"></tbody>
                        </table>
                    </div>
                </div>

                <div id="seccionHistorial" class="d-none mt-4">
                    <h5 class="mb-3"><i class="fas fa-history me-2 text-primary"></i>Historial de Justificaciones</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="tablaHistorial">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Fecha Falta</th>
                                    <th>Materia</th>
                                    <th>Grupo</th>
                                    <th>Motivo</th>
                                    <th>Justificado por</th>
                                    <th>Fecha Justificacion</th>
                                    <th>Accion</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyHistorial"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal justificar una falta -->
    <div class="modal fade" id="modalJustificar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="fas fa-clipboard-check me-2"></i>Justificar Falta</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="justificarAsistenciaId">
                    <input type="hidden" id="justificarEstudianteId">
                    <p id="justificarInfo"></p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo de la justificacion</label>
                        <textarea class="form-control" id="justificarMotivo" rows="4" placeholder="Describa el motivo de la justificacion..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-info" onclick="guardarJustificacion()">
                        <i class="fas fa-save me-1"></i>Guardar Justificacion
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal justificar todo el dia -->
    <div class="modal fade" id="modalJustificarDia" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="fas fa-check-double me-2"></i>Justificar todo el dia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="justificarDiaInfo"></p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo de la justificacion</label>
                        <textarea class="form-control" id="justificarDiaMotivo" rows="4" placeholder="Motivo general para todas las faltas del dia..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-warning" onclick="guardarJustificarDia()">
                        <i class="fas fa-save me-1"></i>Justificar todas las faltas
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let estudianteSeleccionado = null;
        let faltasSinJustificar = 0;

        document.getElementById('fechaFalta').value = new Date().toISOString().split('T')[0];

        document.getElementById('busquedaEstudiante').addEventListener('input', async function() {
            const valor = this.value.trim();
            const lista = document.getElementById('listaEstudiantes');
            if (valor.length < 2) { lista.style.display = 'none'; return; }
            try {
                const res = await fetch(`/api/justificaciones/buscar-estudiante?q=${encodeURIComponent(valor)}`);
                const data = await res.json();
                lista.innerHTML = '';
                if (data.length === 0) { lista.style.display = 'none'; return; }
                data.forEach(e => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'list-group-item list-group-item-action';
                    const disc = e.discapacidad === 'SI' ? ' <span class="badge bg-secondary">D</span>' : '';
                    btn.innerHTML = `<strong>${e.cedula}</strong> - ${e.nombres_apellidos} (${e.curso} ${e.paralelo} - ${e.especialidad || 'N/A'})${disc}`;
                    btn.onclick = function() {
                        estudianteSeleccionado = e;
                        document.getElementById('busquedaEstudiante').value = `${e.cedula} - ${e.nombres_apellidos}`;
                        lista.style.display = 'none';
                        document.getElementById('infoEstudiante').classList.remove('d-none');
                        document.getElementById('infoEstudiante').innerHTML = `<i class="fas fa-user me-1"></i><strong>${e.nombres_apellidos}</strong> - C.I. ${e.cedula} | ${e.curso} ${e.paralelo} - ${e.especialidad || 'N/A'}`;
                    };
                    lista.appendChild(btn);
                });
                lista.style.display = 'block';
            } catch (err) { console.error(err); }
        });

        document.addEventListener('click', function(e) {
            const lista = document.getElementById('listaEstudiantes');
            if (!lista.contains(e.target) && e.target.id !== 'busquedaEstudiante') {
                lista.style.display = 'none';
            }
        });

        async function buscarFaltas() {
            if (!estudianteSeleccionado) { showNotification('Seleccione un estudiante', 'warning'); return; }
            const fecha = document.getElementById('fechaFalta').value;
            try {
                const res = await fetch(`/api/justificaciones/faltas/${estudianteSeleccionado.id}?fecha=${fecha}`);
                const data = await res.json();
                document.getElementById('seccionFaltas').classList.remove('d-none');
                const tbody = document.getElementById('tbodyFaltas');
                tbody.innerHTML = '';
                faltasSinJustificar = 0;
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center text-success">No tiene faltas en esta fecha</td></tr>';
                    document.getElementById('btnJustificarDia').style.display = 'none';
                    return;
                }
                data.forEach((f, i) => {
                    if (!f.justificacion_id) faltasSinJustificar++;
                    const estadoBadge = f.estado === 'ausente'
                        ? '<span class="badge bg-danger">Ausente</span>'
                        : '<span class="badge bg-warning text-dark">Atraso</span>';
                    let accion = '';
                    if (f.justificacion_id) {
                        accion = `<span class="badge bg-success"><i class="fas fa-check me-1"></i>Justificado</span>`;
                    } else {
                        accion = `<button class="btn btn-sm btn-info" onclick="abrirModalJustificar(${f.asistencia_id}, ${estudianteSeleccionado.id}, '${f.nombre_materia}', '${f.nombre_grupo}')"><i class="fas fa-clipboard-check me-1"></i>Justificar</button>`;
                    }
                    tbody.innerHTML += `
                        <tr>
                            <td>${i + 1}</td>
                            <td>${f.nombre_materia}</td>
                            <td>${f.curso} ${f.paralelo}</td>
                            <td>${f.nombre_grupo}</td>
                            <td>${estadoBadge}</td>
                            <td>${f.comentario || '-'}</td>
                            <td>${f.justificacion_id ? '<span class="badge bg-success">Justificado</span>' : '<span class="badge bg-secondary">Sin justificar</span>'}</td>
                            <td>${accion}</td>
                        </tr>`;
                });
                const btnDia = document.getElementById('btnJustificarDia');
                btnDia.style.display = faltasSinJustificar > 0 ? '' : 'none';
                await cargarHistorial();
            } catch (err) { console.error(err); showNotification('Error al buscar faltas', 'danger'); }
        }

        async function cargarHistorial() {
            if (!estudianteSeleccionado) return;
            try {
                const res = await fetch(`/api/justificaciones/historial/${estudianteSeleccionado.id}`);
                const data = await res.json();
                document.getElementById('seccionHistorial').classList.remove('d-none');
                const tbody = document.getElementById('tbodyHistorial');
                tbody.innerHTML = '';
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">Sin justificaciones registradas</td></tr>';
                    return;
                }
                data.forEach((j, i) => {
                    const fechaFalta = j.fecha_falta ? new Date(j.fecha_falta).toLocaleDateString('es-ES') : '-';
                    const fechaJust = j.fecha_justificacion ? new Date(j.fecha_justificacion).toLocaleDateString('es-ES') : '-';
                    tbody.innerHTML += `
                        <tr>
                            <td>${i + 1}</td>
                            <td>${fechaFalta}</td>
                            <td>${j.nombre_materia}</td>
                            <td>${j.nombre_grupo}</td>
                            <td>${j.motivo}</td>
                            <td>${j.justificado_por || '-'}</td>
                            <td>${fechaJust}</td>
                            <td><button class="btn btn-sm btn-danger" onclick="eliminarJustificacion(${j.id})"><i class="fas fa-trash"></i></button></td>
                        </tr>`;
                });
            } catch (err) { console.error(err); }
        }

        function abrirModalJustificar(asistenciaId, estudianteId, materia, grupo) {
            document.getElementById('justificarAsistenciaId').value = asistenciaId;
            document.getElementById('justificarEstudianteId').value = estudianteId;
            document.getElementById('justificarInfo').innerHTML = `<strong>Materia:</strong> ${materia} | <strong>Grupo:</strong> ${grupo}`;
            document.getElementById('justificarMotivo').value = '';
            new bootstrap.Modal(document.getElementById('modalJustificar')).show();
        }

        async function guardarJustificacion() {
            const asistenciaId = document.getElementById('justificarAsistenciaId').value;
            const estudianteId = document.getElementById('justificarEstudianteId').value;
            const motivo = document.getElementById('justificarMotivo').value.trim();
            if (!motivo) { showNotification('Ingrese el motivo', 'warning'); return; }
            try {
                const res = await fetch('/api/justificaciones', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ asistencia_id: parseInt(asistenciaId), estudiante_id: parseInt(estudianteId), motivo })
                });
                const data = await res.json();
                if (res.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('modalJustificar')).hide();
                    showNotification('Justificacion registrada', 'success');
                    buscarFaltas();
                } else {
                    showNotification(data.error || 'Error', 'danger');
                }
            } catch (err) { console.error(err); showNotification('Error al guardar', 'danger'); }
        }

        function abrirModalJustificarDia() {
            if (!estudianteSeleccionado) return;
            const fecha = document.getElementById('fechaFalta').value;
            document.getElementById('justificarDiaInfo').innerHTML = `<strong>Estudiante:</strong> ${estudianteSeleccionado.nombres_apellidos}<br><strong>Fecha:</strong> ${fecha}<br><strong>Faltas sin justificar:</strong> ${faltasSinJustificar}`;
            document.getElementById('justificarDiaMotivo').value = '';
            new bootstrap.Modal(document.getElementById('modalJustificarDia')).show();
        }

        async function guardarJustificarDia() {
            if (!estudianteSeleccionado) return;
            const fecha = document.getElementById('fechaFalta').value;
            const motivo = document.getElementById('justificarDiaMotivo').value.trim();
            if (!motivo) { showNotification('Ingrese el motivo', 'warning'); return; }
            try {
                const res = await fetch('/api/justificaciones/dia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ estudiante_id: estudianteSeleccionado.id, fecha, motivo })
                });
                const data = await res.json();
                if (res.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('modalJustificarDia')).hide();
                    showNotification(data.message, 'success');
                    buscarFaltas();
                } else {
                    showNotification(data.error || 'Error', 'danger');
                }
            } catch (err) { console.error(err); showNotification('Error al guardar', 'danger'); }
        }

        async function eliminarJustificacion(id) {
            if (!confirm('Eliminar esta justificacion?')) return;
            try {
                await fetch(`/api/justificaciones/${id}`, { method: 'DELETE' });
                showNotification('Justificacion eliminada', 'info');
                buscarFaltas();
            } catch (err) { console.error(err); }
        }
    </script>
</body>
</html>
