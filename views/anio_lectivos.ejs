<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion de Años Lectivos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-danger text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-calendar-alt me-2"></i>Gestion de Años Lectivos</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menu</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-list me-1"></i>Años Lectivos</span>
                        <button class="btn btn-success btn-sm" onclick="abrirModal()">
                            <i class="fas fa-plus me-1"></i>Nuevo Año
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm table-hover">
                                <thead class="table-dark text-center">
                                    <tr>
                                        <th>#</th>
                                        <th>Año Lectivo</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="cuerpoTabla"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <!-- Modal Nuevo Año -->
    <div class="modal fade" id="modalAnio" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-calendar-plus me-2"></i>Nuevo Año Lectivo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form onsubmit="guardarAnio(event)">
                    <div class="modal-body">
                        <label class="form-label fw-bold">Año Lectivo *</label>
                        <input type="text" class="form-control" id="campoAnio" required placeholder="Ej: 2027-2028" pattern="\d{4}-\d{4}">
                        <small class="text-muted">Formato: AAAA-AAAA (ej: 2027-2028)</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', cargarAnios);

        async function cargarAnios() {
            try {
                const res = await fetch('/api/anio-lectivos');
                const data = await res.json();
                const tbody = document.getElementById('cuerpoTabla');
                tbody.innerHTML = '';
                data.forEach((item, i) => {
                    tbody.innerHTML += `
                        <tr>
                            <td class="text-center">${i + 1}</td>
                            <td class="fw-bold">${item.anio}</td>
                            <td class="text-center">
                                ${item.activo 
                                    ? '<span class="badge bg-success">Activo</span>' 
                                    : '<span class="badge bg-secondary">Inactivo</span>'}
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm ${item.activo ? 'btn-warning' : 'btn-success'}" 
                                        onclick="toggleAnio(${item.id})" title="${item.activo ? 'Desactivar' : 'Activar'}">
                                    <i class="fas fa-${item.activo ? 'pause' : 'play'}"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="eliminarAnio(${item.id}, '${item.anio}')" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>`;
                });
            } catch (err) {
                showNotification('Error al cargar años', 'danger');
            }
        }

        function abrirModal() {
            document.getElementById('campoAnio').value = '';
            new bootstrap.Modal(document.getElementById('modalAnio')).show();
        }

        async function guardarAnio(e) {
            e.preventDefault();
            const anio = document.getElementById('campoAnio').value;
            try {
                const res = await fetch('/api/anio-lectivos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ anio })
                });
                const result = await res.json();
                if (res.ok) {
                    showNotification(result.message, 'success');
                    bootstrap.Modal.getInstance(document.getElementById('modalAnio')).hide();
                    cargarAnios();
                } else {
                    showNotification(result.error, 'danger');
                }
            } catch (err) {
                showNotification('Error de conexion', 'danger');
            }
        }

        async function toggleAnio(id) {
            try {
                await fetch(`/api/anio-lectivos/${id}/toggle`, { method: 'PUT' });
                cargarAnios();
            } catch (err) {
                showNotification('Error', 'danger');
            }
        }

        async function eliminarAnio(id, anio) {
            if (!confirm(`Eliminar el año lectivo "${anio}"?`)) return;
            try {
                await fetch(`/api/anio-lectivos/${id}`, { method: 'DELETE' });
                showNotification('Año eliminado', 'success');
                cargarAnios();
            } catch (err) {
                showNotification('Error', 'danger');
            }
        }
    </script>
</body>
</html>
