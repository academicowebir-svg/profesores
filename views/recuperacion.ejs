<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperacion Pedagogica</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><img src="/images/sucua2.png" alt="Logo" style="width:40px; height:40px; border-radius:50%; margin-right:8px;">Recuperacion Pedagogica</a>
            <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home me-1"></i>Menu Principal</a>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h4 class="mb-0"><i class="fas fa-hands-helping me-2"></i>Recuperacion Pedagogica</h4>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabPlanes"><i class="fas fa-clipboard-list me-1"></i>Plan de Refuerzo</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAsistencia"><i class="fas fa-user-check me-1"></i>Asistencia</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabEvaluaciones"><i class="fas fa-graduation-cap me-1"></i>Evaluaciones</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- ==================== PLAN DE REFUERZO ==================== -->
                    <div class="tab-pane fade show active" id="tabPlanes">
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">Materia</label>
                                        <select class="form-select" id="planMateriaSelect" onchange="cargarEstudiantesPlan()">
                                            <option value="">Seleccionar...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button class="btn btn-primary w-100" onclick="cargarPlanes()"><i class="fas fa-search me-1"></i>Buscar Planes</button>
                                    </div>
                                    <div class="col-md-3">
                                        <button class="btn btn-success w-100" onclick="abrirModalPlan()"><i class="fas fa-plus me-1"></i>Nuevo Plan</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Estudiante</th>
                                        <th>Materia</th>
                                        <th>Trimestre</th>
                                        <th>Estrategia</th>
                                        <th>Fecha Inicio</th>
                                        <th>Fecha Fin</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyPlanes"></tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ==================== ASISTENCIA ==================== -->
                    <div class="tab-pane fade" id="tabAsistencia">
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">Materia</label>
                                        <select class="form-select" id="asisMateriaSelect" onchange="cargarEstudiantesAsistencia()">
                                            <option value="">Seleccionar...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Fecha</label>
                                        <input type="date" class="form-control" id="asisFecha">
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-primary w-100" onclick="cargarAsistencia()"><i class="fas fa-search me-1"></i>Buscar</button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-success w-100" onclick="guardarAsistencia()"><i class="fas fa-save me-1"></i>Guardar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Estudiante</th>
                                        <th>Estado</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyAsistencia"></tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ==================== EVALUACIONES ==================== -->
                    <div class="tab-pane fade" id="tabEvaluaciones">
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">Materia</label>
                                        <select class="form-select" id="evalMateriaSelect" onchange="cargarEstudiantesEvaluacion()">
                                            <option value="">Seleccionar...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button class="btn btn-primary w-100" onclick="cargarEvaluaciones()"><i class="fas fa-search me-1"></i>Buscar</button>
                                    </div>
                                    <div class="col-md-3">
                                        <button class="btn btn-success w-100" onclick="abrirModalEvaluacion()"><i class="fas fa-plus me-1"></i>Nueva Evaluacion</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Estudiante</th>
                                        <th>Materia</th>
                                        <th>Fecha</th>
                                        <th>Tipo</th>
                                        <th>Valoracion</th>
                                        <th>Nota</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyEvaluaciones"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Plan de Refuerzo -->
    <div class="modal fade" id="modalPlan" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="modalPlanTitle">Nuevo Plan de Refuerzo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="planEditId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Materia *</label>
                            <select class="form-select" id="planModalMateria" onchange="cargarEstudiantesPlanModal()">
                                <option value="">Seleccionar...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estudiante *</label>
                            <select class="form-select" id="planModalEstudiante">
                                <option value="">Seleccionar materia primero...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Trimestre</label>
                            <select class="form-select" id="planModalTrimestre">
                                <option value="1">1er Trimestre</option>
                                <option value="2">2do Trimestre</option>
                                <option value="3">3er Trimestre</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Inicio</label>
                            <input type="date" class="form-control" id="planModalFechaInicio">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Fin</label>
                            <input type="date" class="form-control" id="planModalFechaFin">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estrategia *</label>
                            <input type="text" class="form-control" id="planModalEstrategia" placeholder="Ej: Refuerzo individual en clase">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estado</label>
                            <select class="form-select" id="planModalEstado">
                                <option value="en_progreso">En Progreso</option>
                                <option value="completado">Completado</option>
                                <option value="cancelado">Cancelado</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Objetivos</label>
                            <textarea class="form-control" id="planModalObjetivos" rows="3" placeholder="Objetivos del plan de refuerzo..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Recursos</label>
                            <textarea class="form-control" id="planModalRecursos" rows="3" placeholder="Materiales y recursos a utilizar..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Actividades</label>
                            <textarea class="form-control" id="planModalActividades" rows="3" placeholder="Actividades planificadas..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="guardarPlan()">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Evaluacion -->
    <div class="modal fade" id="modalEvaluacion" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="modalEvaluacionTitle">Nueva Evaluacion de Recuperacion</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="evalEditId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Materia *</label>
                            <select class="form-select" id="evalModalMateria" onchange="cargarEstudiantesEvalModal()">
                                <option value="">Seleccionar...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estudiante *</label>
                            <select class="form-select" id="evalModalEstudiante">
                                <option value="">Seleccionar materia primero...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha *</label>
                            <input type="date" class="form-control" id="evalModalFecha">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" id="evalModalTipo">
                                <option value="recuperacion">Recuperacion</option>
                                <option value="supletorio">Supletorio</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nota</label>
                            <input type="number" class="form-control" id="evalModalNota" min="0" max="10" step="0.01">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Valoracion</label>
                            <input type="text" class="form-control" id="evalModalValoracion" placeholder="Ej: Requiere apoyo adicional">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" id="evalModalObservaciones" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success" onclick="guardarEvaluacion()">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let materiasData = [];
        let estudiantesPlanData = [];
        let estudiantesAsisData = [];
        let estudiantesEvalData = [];

        document.addEventListener('DOMContentLoaded', cargarMaterias);

        async function cargarMaterias() {
            try {
                const res = await fetch('/api/recuperacion/materias');
                materiasData = await res.json();
                ['planMateriaSelect', 'asisMateriaSelect', 'evalMateriaSelect', 'planModalMateria', 'evalModalMateria'].forEach(id => {
                    const sel = document.getElementById(id);
                    if (!sel) return;
                    sel.innerHTML = '<option value="">Seleccionar...</option>';
                    materiasData.forEach(m => {
                        const esp = m.especialidad ? ' - ' + m.especialidad : '';
                        sel.innerHTML += '<option value="' + m.id + '">' + m.nombre_materia + ' (' + m.curso + ' ' + m.paralelo + esp + ')</option>';
                    });
                });
            } catch (err) {
                showNotification('Error al cargar materias', 'danger');
            }
        }

        async function cargarEstudiantes(materiaId) {
            if (!materiaId) return [];
            try {
                const res = await fetch('/api/recuperacion/materias/' + materiaId + '/estudiantes');
                return await res.json();
            } catch (err) { return []; }
        }

        // ========== PLAN DE REFUERZO ==========

        async function cargarEstudiantesPlan() {
            const materiaId = document.getElementById('planMateriaSelect').value;
            estudiantesPlanData = await cargarEstudiantes(materiaId);
        }

        async function cargarEstudiantesPlanModal() {
            const materiaId = document.getElementById('planModalMateria').value;
            const estudiantes = await cargarEstudiantes(materiaId);
            const sel = document.getElementById('planModalEstudiante');
            sel.innerHTML = '<option value="">Seleccionar...</option>';
            estudiantes.forEach(e => {
                sel.innerHTML += '<option value="' + e.id + '">' + e.cedula + ' - ' + e.nombres_apellidos + '</option>';
            });
        }

        async function cargarPlanes() {
            const materiaId = document.getElementById('planMateriaSelect').value;
            let url = '/api/recuperacion/planes';
            if (materiaId) url += '?materia_id=' + materiaId;
            try {
                const res = await fetch(url);
                const data = await res.json();
                const tbody = document.getElementById('tbodyPlanes');
                tbody.innerHTML = '';
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">No hay planes registrados</td></tr>';
                    return;
                }
                data.forEach((p, i) => {
                    const estadoBadge = p.estado === 'completado' ? 'bg-success' : p.estado === 'cancelado' ? 'bg-secondary' : 'bg-warning text-dark';
                    const esp = p.especialidad ? ' - ' + p.especialidad : '';
                    tbody.innerHTML += '<tr>' +
                        '<td>' + (i + 1) + '</td>' +
                        '<td>' + p.nombres_apellidos + '</td>' +
                        '<td>' + p.nombre_materia + ' (' + p.curso + ' ' + p.paralelo + esp + ')</td>' +
                        '<td>' + p.trimestre + '</td>' +
                        '<td>' + p.estrategia + '</td>' +
                        '<td>' + (p.fecha_inicio || '-') + '</td>' +
                        '<td>' + (p.fecha_fin || '-') + '</td>' +
                        '<td><span class="badge ' + estadoBadge + '">' + p.estado.replace('_', ' ') + '</span></td>' +
                        '<td>' +
                        '<button class="btn btn-sm btn-warning me-1" onclick="editarPlan(' + p.id + ')" title="Editar"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-sm btn-danger" onclick="eliminarPlan(' + p.id + ')" title="Eliminar"><i class="fas fa-trash"></i></button>' +
                        '</td></tr>';
                });
            } catch (err) {
                showNotification('Error al cargar planes', 'danger');
            }
        }

        function abrirModalPlan() {
            document.getElementById('planEditId').value = '';
            document.getElementById('planModalMateria').value = '';
            document.getElementById('planModalEstudiante').innerHTML = '<option value="">Seleccionar materia primero...</option>';
            document.getElementById('planModalTrimestre').value = '1';
            document.getElementById('planModalFechaInicio').value = '';
            document.getElementById('planModalFechaFin').value = '';
            document.getElementById('planModalEstrategia').value = '';
            document.getElementById('planModalEstado').value = 'en_progreso';
            document.getElementById('planModalObjetivos').value = '';
            document.getElementById('planModalRecursos').value = '';
            document.getElementById('planModalActividades').value = '';
            document.getElementById('modalPlanTitle').textContent = 'Nuevo Plan de Refuerzo';
            new bootstrap.Modal(document.getElementById('modalPlan')).show();
        }

        async function editarPlan(id) {
            try {
                const res = await fetch('/api/recuperacion/planes');
                const data = await res.json();
                const p = data.find(x => x.id === id);
                if (!p) return;
                document.getElementById('planEditId').value = p.id;
                document.getElementById('planModalMateria').value = p.materia_id;
                await cargarEstudiantesPlanModal();
                document.getElementById('planModalEstudiante').value = p.estudiante_id;
                document.getElementById('planModalTrimestre').value = p.trimestre;
                document.getElementById('planModalFechaInicio').value = p.fecha_inicio ? p.fecha_inicio.split('T')[0] : '';
                document.getElementById('planModalFechaFin').value = p.fecha_fin ? p.fecha_fin.split('T')[0] : '';
                document.getElementById('planModalEstrategia').value = p.estrategia;
                document.getElementById('planModalEstado').value = p.estado;
                document.getElementById('planModalObjetivos').value = p.objetivos || '';
                document.getElementById('planModalRecursos').value = p.recursos || '';
                document.getElementById('planModalActividades').value = p.actividades || '';
                document.getElementById('modalPlanTitle').textContent = 'Editar Plan de Refuerzo';
                new bootstrap.Modal(document.getElementById('modalPlan')).show();
            } catch (err) {
                showNotification('Error al cargar plan', 'danger');
            }
        }

        async function guardarPlan() {
            const editId = document.getElementById('planEditId').value;
            const body = {
                estudiante_id: document.getElementById('planModalEstudiante').value,
                materia_id: document.getElementById('planModalMateria').value,
                trimestre: document.getElementById('planModalTrimestre').value,
                estrategia: document.getElementById('planModalEstrategia').value,
                objetivos: document.getElementById('planModalObjetivos').value,
                recursos: document.getElementById('planModalRecursos').value,
                actividades: document.getElementById('planModalActividades').value,
                fecha_inicio: document.getElementById('planModalFechaInicio').value,
                fecha_fin: document.getElementById('planModalFechaFin').value,
                estado: document.getElementById('planModalEstado').value
            };
            if (!body.estudiante_id || !body.materia_id || !body.estrategia) {
                showNotification('Complete materia, estudiante y estrategia', 'warning');
                return;
            }
            try {
                const url = editId ? '/api/recuperacion/planes/' + editId : '/api/recuperacion/planes';
                const method = editId ? 'PUT' : 'POST';
                const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                if (res.ok) {
                    showNotification(editId ? 'Plan actualizado' : 'Plan creado', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('modalPlan')).hide();
                    cargarPlanes();
                }
            } catch (err) {
                showNotification('Error al guardar', 'danger');
            }
        }

        async function eliminarPlan(id) {
            if (!confirm('Eliminar este plan?')) return;
            try {
                const res = await fetch('/api/recuperacion/planes/' + id, { method: 'DELETE' });
                if (res.ok) { showNotification('Plan eliminado', 'success'); cargarPlanes(); }
            } catch (err) {
                showNotification('Error al eliminar', 'danger');
            }
        }

        // ========== ASISTENCIA ==========

        async function cargarEstudiantesAsistencia() {
            const materiaId = document.getElementById('asisMateriaSelect').value;
            if (!materiaId) { estudiantesAsisData = []; renderizarAsistencia(); return; }
            try {
                const res = await fetch('/api/recuperacion/materias/' + materiaId + '/estudiantes-con-plan');
                estudiantesAsisData = await res.json();
            } catch (err) { estudiantesAsisData = []; }
            renderizarAsistencia();
        }

        function renderizarAsistencia() {
            const tbody = document.getElementById('tbodyAsistencia');
            tbody.innerHTML = '';
            if (estudiantesAsisData.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No hay estudiantes con plan de refuerzo activo en esta materia</td></tr>';
                return;
            }
            estudiantesAsisData.forEach((e, i) => {
                tbody.innerHTML += '<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + e.cedula + ' - ' + e.nombres_apellidos + '</td>' +
                    '<td><select class="form-select form-select-sm" id="asisEstado_' + e.id + '">' +
                    '<option value="presente">Presente</option><option value="ausente">Ausente</option><option value="atraso">Atraso</option></select></td>' +
                    '<td><input type="text" class="form-control form-control-sm" id="asisObs_' + e.id + '" placeholder="Observacion..."></td>' +
                    '</tr>';
            });
        }

        async function cargarAsistencia() {
            const materiaId = document.getElementById('asisMateriaSelect').value;
            const fecha = document.getElementById('asisFecha').value;
            if (!materiaId || !fecha) { showNotification('Seleccione materia y fecha', 'warning'); return; }
            try {
                const res = await fetch('/api/recuperacion/asistencia?materia_id=' + materiaId + '&fecha=' + fecha);
                const data = await res.json();
                if (data.length > 0) {
                    data.forEach(a => {
                        const sel = document.getElementById('asisEstado_' + a.estudiante_id);
                        const obs = document.getElementById('asisObs_' + a.estudiante_id);
                        if (sel) sel.value = a.estado;
                        if (obs) obs.value = a.observaciones || '';
                    });
                    showNotification('Asistencia cargada', 'info');
                }
            } catch (err) {
                showNotification('Error al cargar asistencia', 'danger');
            }
        }

        async function guardarAsistencia() {
            const materiaId = document.getElementById('asisMateriaSelect').value;
            const fecha = document.getElementById('asisFecha').value;
            if (!materiaId || !fecha) { showNotification('Seleccione materia y fecha', 'warning'); return; }
            const registros = estudiantesAsisData.map(e => ({
                estudiante_id: e.id,
                estado: document.getElementById('asisEstado_' + e.id).value,
                observaciones: document.getElementById('asisObs_' + e.id).value
            }));
            try {
                const res = await fetch('/api/recuperacion/asistencia/batch', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ materia_id: materiaId, fecha, registros })
                });
                if (res.ok) showNotification('Asistencia guardada', 'success');
            } catch (err) {
                showNotification('Error al guardar', 'danger');
            }
        }

        // ========== EVALUACIONES ==========

        async function cargarEstudiantesEvaluacion() {
            const materiaId = document.getElementById('evalMateriaSelect').value;
            estudiantesEvalData = await cargarEstudiantes(materiaId);
        }

        async function cargarEstudiantesEvalModal() {
            const materiaId = document.getElementById('evalModalMateria').value;
            const estudiantes = await cargarEstudiantes(materiaId);
            const sel = document.getElementById('evalModalEstudiante');
            sel.innerHTML = '<option value="">Seleccionar...</option>';
            estudiantes.forEach(e => {
                sel.innerHTML += '<option value="' + e.id + '">' + e.cedula + ' - ' + e.nombres_apellidos + '</option>';
            });
        }

        async function cargarEvaluaciones() {
            const materiaId = document.getElementById('evalMateriaSelect').value;
            let url = '/api/recuperacion/evaluaciones';
            if (materiaId) url += '?materia_id=' + materiaId;
            try {
                const res = await fetch(url);
                const data = await res.json();
                const tbody = document.getElementById('tbodyEvaluaciones');
                tbody.innerHTML = '';
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">No hay evaluaciones registradas</td></tr>';
                    return;
                }
                data.forEach((ev, i) => {
                    const tipoBadge = ev.tipo === 'supletorio' ? 'bg-warning text-dark' : 'bg-info';
                    tbody.innerHTML += '<tr>' +
                        '<td>' + (i + 1) + '</td>' +
                        '<td>' + ev.nombres_apellidos + '</td>' +
                        '<td>' + ev.nombre_materia + '</td>' +
                        '<td>' + (ev.fecha ? ev.fecha.split('T')[0] : '-') + '</td>' +
                        '<td><span class="badge ' + tipoBadge + '">' + ev.tipo + '</span></td>' +
                        '<td>' + (ev.valoracion || '-') + '</td>' +
                        '<td class="fw-bold">' + (ev.nota !== null ? ev.nota : '-') + '</td>' +
                        '<td>' +
                        '<button class="btn btn-sm btn-warning me-1" onclick="editarEvaluacion(' + ev.id + ')" title="Editar"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-sm btn-danger" onclick="eliminarEvaluacion(' + ev.id + ')" title="Eliminar"><i class="fas fa-trash"></i></button>' +
                        '</td></tr>';
                });
            } catch (err) {
                showNotification('Error al cargar evaluaciones', 'danger');
            }
        }

        function abrirModalEvaluacion() {
            document.getElementById('evalEditId').value = '';
            document.getElementById('evalModalMateria').value = '';
            document.getElementById('evalModalEstudiante').innerHTML = '<option value="">Seleccionar materia primero...</option>';
            document.getElementById('evalModalFecha').value = new Date().toISOString().split('T')[0];
            document.getElementById('evalModalTipo').value = 'recuperacion';
            document.getElementById('evalModalNota').value = '';
            document.getElementById('evalModalValoracion').value = '';
            document.getElementById('evalModalObservaciones').value = '';
            document.getElementById('modalEvaluacionTitle').textContent = 'Nueva Evaluacion de Recuperacion';
            new bootstrap.Modal(document.getElementById('modalEvaluacion')).show();
        }

        async function editarEvaluacion(id) {
            try {
                const res = await fetch('/api/recuperacion/evaluaciones');
                const data = await res.json();
                const ev = data.find(x => x.id === id);
                if (!ev) return;
                document.getElementById('evalEditId').value = ev.id;
                document.getElementById('evalModalMateria').value = ev.materia_id;
                await cargarEstudiantesEvalModal();
                document.getElementById('evalModalEstudiante').value = ev.estudiante_id;
                document.getElementById('evalModalFecha').value = ev.fecha ? ev.fecha.split('T')[0] : '';
                document.getElementById('evalModalTipo').value = ev.tipo;
                document.getElementById('evalModalNota').value = ev.nota !== null ? ev.nota : '';
                document.getElementById('evalModalValoracion').value = ev.valoracion || '';
                document.getElementById('evalModalObservaciones').value = ev.observaciones || '';
                document.getElementById('modalEvaluacionTitle').textContent = 'Editar Evaluacion';
                new bootstrap.Modal(document.getElementById('modalEvaluacion')).show();
            } catch (err) {
                showNotification('Error al cargar evaluacion', 'danger');
            }
        }

        async function guardarEvaluacion() {
            const editId = document.getElementById('evalEditId').value;
            const body = {
                estudiante_id: document.getElementById('evalModalEstudiante').value,
                materia_id: document.getElementById('evalModalMateria').value,
                fecha: document.getElementById('evalModalFecha').value,
                tipo: document.getElementById('evalModalTipo').value,
                nota: document.getElementById('evalModalNota').value || null,
                valoracion: document.getElementById('evalModalValoracion').value,
                observaciones: document.getElementById('evalModalObservaciones').value
            };
            if (!body.estudiante_id || !body.materia_id || !body.fecha) {
                showNotification('Complete materia, estudiante y fecha', 'warning');
                return;
            }
            try {
                const url = editId ? '/api/recuperacion/evaluaciones/' + editId : '/api/recuperacion/evaluaciones';
                const method = editId ? 'PUT' : 'POST';
                const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                if (res.ok) {
                    showNotification(editId ? 'Evaluacion actualizada' : 'Evaluacion registrada', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('modalEvaluacion')).hide();
                    cargarEvaluaciones();
                }
            } catch (err) {
                showNotification('Error al guardar', 'danger');
            }
        }

        async function eliminarEvaluacion(id) {
            if (!confirm('Eliminar esta evaluacion?')) return;
            try {
                const res = await fetch('/api/recuperacion/evaluaciones/' + id, { method: 'DELETE' });
                if (res.ok) { showNotification('Evaluacion eliminada', 'success'); cargarEvaluaciones(); }
            } catch (err) {
                showNotification('Error al eliminar', 'danger');
            }
        }
    </script>
</body>
</html>
