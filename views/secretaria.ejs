<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matricula de Estudiantes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-info text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-user-graduate me-2"></i>Matricula de Estudiantes</h1>
                <div>
                    <button class="btn btn-outline-light btn-sm me-2" onclick="abrirModalCursos()">
                        <i class="fas fa-chalkboard me-1"></i>Gestionar Cursos
                    </button>
                    <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menu</a>
                </div>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">
                <!-- GRUPOS POR CURSO, PARALELO Y ESPECIALIDAD -->
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-chalkboard me-1"></i>Cursos, Paralelos y Especialidades</span>
                        <span id="totalEstudiantes" class="badge bg-primary"></span>
                    </div>
                    <div class="card-body" style="max-height: 250px; overflow-y: auto;">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0" id="tablaGrupos">
                                <thead class="table-light">
                                    <tr>
                                        <th>Curso</th>
                                        <th>Paralelo</th>
                                        <th>Especialidad</th>
                                        <th class="text-center">Estudiantes</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="cuerpoGrupos"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- TABLA DE ESTUDIANTES -->
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <span><i class="fas fa-list me-1"></i>Estudiantes</span>
                            <span id="filtroActivo" class="badge bg-info ms-2" style="display:none;"></span>
                            <span id="contadorEstudiantes" class="text-muted ms-2"></span>
                        </div>
                        <div>
                            <button class="btn btn-outline-secondary btn-sm me-2" id="btnMostrarTodos" style="display:none;" onclick="mostrarTodos()">
                                <i class="fas fa-times me-1"></i>Mostrar Todos
                            </button>
                            <a href="/api/secretaria/plantilla-excel" class="btn btn-outline-primary btn-sm me-2">
                                <i class="fas fa-file-excel me-1"></i>Plantilla
                            </a>
                            <button class="btn btn-warning btn-sm me-2" onclick="abrirModalImportar()">
                                <i class="fas fa-file-upload me-1"></i>Importar Excel
                            </button>
                            <button class="btn btn-success btn-sm" onclick="abrirModalCrear()">
                                <i class="fas fa-plus me-1"></i>Nueva Matricula
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <input type="text" class="form-control" id="buscador" placeholder="Buscar por matrícula, nombre, cédula, curso..." oninput="filtrarEstudiantes()">
                            </div>
                            <div class="col-md-4">
                                <select class="form-select" id="filtroEspecialidad" onchange="filtrarEstudiantes()">
                                    <option value="">Todas las especialidades</option>
                                    <option value="Contabilidad">Contabilidad</option>
                                    <option value="Informatica">Informatica</option>
                                    <option value="Mecanica">Mecanica</option>
                                    <option value="Ciencias">Ciencias</option>
                                </select>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm table-hover" id="tablaEstudiantes">
                                <thead class="table-dark text-center">
                                    <tr>
                                        <th>#</th>
                                        <th>Matrícula</th>
                                        <th>Cédula</th>
                                        <th>Nombres y Apellidos</th>
                                        <th>Sexo</th>
                                        <th>Curso</th>
                                        <th>Paralelo</th>
                                        <th>Especialidad</th>
                                        <th>Representante</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="cuerpoTabla"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <!-- Modal Importar Excel -->
    <div class="modal fade" id="modalImportar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="fas fa-file-excel me-2"></i>Importar Estudiantes desde Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-1"></i>
                        Descargue la <a href="/api/secretaria/plantilla-excel" class="alert-link">plantilla Excel</a> para ver el formato requerido. 
                        Las cedulas duplicadas seran omitidas automaticamente.
                    </div>
                    <form id="formImportar" onsubmit="importarExcel(event)">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Seleccionar archivo Excel (.xlsx)</label>
                            <input type="file" class="form-control" id="archivoExcel" accept=".xlsx,.xls" required>
                        </div>
                        <div id="resultadoImportacion" style="display:none;"></div>
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-warning" id="btnImportar">
                                <i class="fas fa-upload me-1"></i>Importar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Gestion de Cursos -->
    <div class="modal fade" id="modalCursos" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="fas fa-chalkboard me-2"></i>Gestion de Cursos</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <input type="text" class="form-control" id="campoNombreCurso" placeholder="Nombre del curso (ej: Cuarto)">
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control" id="campoParalelos" placeholder="Paralelos (ej: A,B,C)">
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control" id="campoEspecialidades" placeholder="Especialidades (ej: Info,Contab)">
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-success w-100" onclick="guardarCurso()" title="Agregar">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-dark text-center">
                                <tr>
                                    <th>Curso</th>
                                    <th>Paralelos</th>
                                    <th>Especialidades</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="cuerpoCursos"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Matricula -->
    <div class="modal fade" id="modalMatricula" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="modalTitle"><i class="fas fa-user-plus me-2"></i>Nueva Matricula</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formMatricula" onsubmit="guardarEstudiante(event)">
                    <div class="modal-body">
                        <input type="hidden" id="editId">

                        <!-- DATOS DE MATRICULA -->
                        <h6 class="text-primary border-bottom pb-2 mb-3"><i class="fas fa-graduation-cap me-1"></i>Datos de Matricula</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Ano Lectivo *</label>
                                <select class="form-select" id="campoAnioLectivo" required>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Curso *</label>
                                <select class="form-select" id="campoCurso" required onchange="actualizarParalelosYEspecialidades()">
                                    <option value="">Seleccionar...</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Paralelo *</label>
                                <select class="form-select" id="campoParalelo" required>
                                    <option value="">Seleccionar...</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Especialidad</label>
                                <select class="form-select" id="campoEspecialidad">
                                    <option value="">Seleccionar...</option>
                                </select>
                            </div>
                        </div>

                        <!-- DATOS PERSONALES -->
                        <h6 class="text-primary border-bottom pb-2 mb-3"><i class="fas fa-user me-1"></i>Datos Personales del Estudiante</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Cedula *</label>
                                <input type="text" class="form-control" id="campoCedula" required placeholder="Numero de cedula" onblur="buscarEstudianteAnterior(this.value)">
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Nombres y Apellidos *</label>
                                <input type="text" class="form-control" id="campoNombre" required placeholder="Nombres y apellidos completos">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Fecha Nacimiento</label>
                                <input type="date" class="form-control" id="campoFechaNac" onchange="calcularEdad()">
                            </div>
                            <div class="col-md-1 mb-3">
                                <label class="form-label fw-bold">Edad</label>
                                <input type="number" class="form-control" id="campoEdad" readonly>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label fw-bold">Genero *</label>
                                <select class="form-select" id="campoSexo" required>
                                    <option value="M">Masculino</option>
                                    <option value="F">Femenino</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Correo Electronico</label>
                                <input type="email" class="form-control" id="campoEmail" placeholder="correo@ejemplo.com">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Tipo de Sangre</label>
                                <select class="form-select" id="campoTipoSangre">
                                    <option value="">Seleccionar...</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Discapacidad</label>
                                <select class="form-select" id="campoDiscapacidad" onchange="toggleDiscapacidad()">
                                    <option value="NO">No</option>
                                    <option value="SI">Si</option>
                                </select>
                            </div>
                            <div class="col-md-9 mb-3" id="divDiscapacidadTipo" style="display:none;">
                                <label class="form-label fw-bold">Tipo de Discapacidad</label>
                                <input type="text" class="form-control" id="campoDiscapacidadTipo" placeholder="Ej: Visual, Auditiva, Motriz, Cognitive...">
                            </div>
                        </div>

                        <!-- DATOS DE UBICACION -->
                        <h6 class="text-primary border-bottom pb-2 mb-3 mt-4"><i class="fas fa-map-marker-alt me-1"></i>Datos de Ubicacion y Domicilio</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Pais</label>
                                <input type="text" class="form-control" id="campoPais" value="Ecuador" placeholder="Pais">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Provincia</label>
                                <input type="text" class="form-control" id="campoProvincia" placeholder="Provincia">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Ciudad</label>
                                <input type="text" class="form-control" id="campoCiudad" placeholder="Ciudad">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Parroquia</label>
                                <input type="text" class="form-control" id="campoParroquia" placeholder="Parroquia">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Direccion Exacta</label>
                            <input type="text" class="form-control" id="campoDireccion" placeholder="Direccion del domicilio actual">
                        </div>

                        <!-- DATOS DEL REPRESENTANTE -->
                        <h6 class="text-primary border-bottom pb-2 mb-3 mt-4"><i class="fas fa-user-tie me-1"></i>Datos del Representante Legal</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Nombres y Apellidos del Representante</label>
                                <input type="text" class="form-control" id="campoRepresentante" placeholder="Nombre completo del padre/madre/representante">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Cédula del Representante</label>
                                <input type="text" class="form-control" id="campoCedulaRep" placeholder="Cédula">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Parentesco</label>
                                <select class="form-select" id="campoParentescoRep">
                                    <option value="">Seleccionar...</option>
                                    <option value="Padre">Padre</option>
                                    <option value="Madre">Madre</option>
                                    <option value="Abuelo/a">Abuelo/a</option>
                                    <option value="Tío/a">Tío/a</option>
                                    <option value="Hermano/a">Hermano/a</option>
                                    <option value="Tutor Legal">Tutor Legal</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Teléfono Celular</label>
                                <input type="text" class="form-control" id="campoTelefonoRep" placeholder="0999999999">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Correo del Representante</label>
                                <input type="email" class="form-control" id="campoEmailRep" placeholder="correo@ejemplo.com">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Lugar de Trabajo</label>
                                <input type="text" class="form-control" id="campoTrabajoRep" placeholder="Lugar de trabajo del representante">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success" id="btnGuardar">Guardar Matricula</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        let estudiantesData = [];
        let grupoActivo = null;
        let cursosData = [];
        let aniosLectivos = [];

        document.addEventListener('DOMContentLoaded', () => {
            cargarAniosLectivos();
            cargarCursos();
            cargarEstudiantes();
        });

        async function cargarAniosLectivos() {
            try {
                const res = await fetch('/api/years');
                aniosLectivos = await res.json();
                const select = document.getElementById('campoAnioLectivo');
                select.innerHTML = '';
                aniosLectivos.forEach(anio => {
                    const option = document.createElement('option');
                    option.value = anio;
                    option.textContent = anio;
                    select.appendChild(option);
                });
            } catch (err) {
                aniosLectivos = ['2026-2027'];
                document.getElementById('campoAnioLectivo').innerHTML = '<option value="2026-2027">2026-2027</option>';
            }
        }

        async function cargarCursos() {
            try {
                const res = await fetch('/api/cursos');
                cursosData = await res.json();
            } catch (err) {
                cursosData = [];
            }
        }

        async function cargarEstudiantes() {
            try {
                const res = await fetch('/api/secretaria/estudiantes');
                estudiantesData = await res.json();
                renderizarGrupos();
                renderizarTabla(estudiantesData);
                document.getElementById('totalEstudiantes').textContent = `${estudiantesData.length} estudiantes`;
            } catch (err) {
                showNotification('Error al cargar estudiantes', 'danger');
            }
        }

        function renderizarGrupos() {
            const tbody = document.getElementById('cuerpoGrupos');
            let html = '';

            const conteos = {};
            estudiantesData.forEach(est => {
                const key = `${est.curso || 'Sin curso'}-${est.paralelo || '-'}-${est.especialidad || '-'}`;
                if (!conteos[key]) conteos[key] = { curso: est.curso || 'Sin curso', paralelo: est.paralelo || '-', especialidad: est.especialidad || '-', total: 0 };
                conteos[key].total++;
            });

            const cursosActivos = cursosData.filter(c => c.activo);
            cursosActivos.forEach(curso => {
                const pars = (curso.paralelos || 'A,B').split(',').map(p => p.trim()).filter(Boolean);
                const esps = curso.especialidades ? curso.especialidades.split(',').map(e => e.trim()).filter(Boolean) : [''];
                
                pars.forEach(paralelo => {
                    if (esps.length === 0) esps.push('');
                    esps.forEach(especialidad => {
                        const key = `${curso.nombre}-${paralelo}-${especialidad || '-'}`;
                        const info = conteos[key] || { total: 0 };
                        const activo = grupoActivo === key;

                        html += `
                            <tr class="${activo ? 'table-primary' : ''}" style="cursor:pointer;">
                                <td>${curso.nombre}</td>
                                <td class="text-center">${paralelo}</td>
                                <td>${especialidad || '-'}</td>
                                <td class="text-center"><strong>${info.total}</strong></td>
                                <td class="text-center">
                                    <button class="btn btn-sm ${activo ? 'btn-primary' : 'btn-outline-primary'}" 
                                            onclick="filtrarPorGrupo('${key}', '${curso.nombre}', '${paralelo}', '${especialidad || '-'}')" title="Ver grupo">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-success" 
                                            onclick="abrirModalCrearGrupo('${curso.nombre}', '${paralelo}', '${especialidad || '-'}')" title="Agregar">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </td>
                            </tr>`;
                    });
                });
            });
            tbody.innerHTML = html;
        }

        function filtrarPorGrupo(key, curso, paralelo, especialidad) {
            grupoActivo = key;
            renderizarGrupos();
            let filtrados = estudiantesData.filter(e =>
                e.curso === curso && e.paralelo === paralelo && e.especialidad === especialidad
            );
            renderizarTabla(filtrados);
            document.getElementById('filtroActivo').style.display = 'inline';
            document.getElementById('filtroActivo').textContent = `${curso} ${paralelo} - ${especialidad}`;
            document.getElementById('btnMostrarTodos').style.display = 'inline-block';
            document.getElementById('contadorEstudiantes').textContent = `Mostrando ${filtrados.length} de ${estudiantesData.length}`;
            document.getElementById('filtroEspecialidad').value = '';
        }

        function mostrarTodos() {
            grupoActivo = null;
            document.getElementById('filtroEspecialidad').value = '';
            renderizarGrupos();
            renderizarTabla(estudiantesData);
            document.getElementById('filtroActivo').style.display = 'none';
            document.getElementById('btnMostrarTodos').style.display = 'none';
            document.getElementById('contadorEstudiantes').textContent = '';
        }

        function renderizarTabla(data) {
            const tbody = document.getElementById('cuerpoTabla');
            let html = '';
            data.forEach((est, i) => {
                html += `
                    <tr>
                        <td class="text-center">${i + 1}</td>
                        <td class="text-center"><strong>${est.numero_matricula || '-'}</strong></td>
                        <td class="text-center">${est.cedula || '-'}</td>
                        <td>${est.nombres_apellidos}</td>
                        <td class="text-center">${est.sexo === 'M' ? 'M' : 'F'}</td>
                        <td class="text-center">${est.curso || '-'}</td>
                        <td class="text-center">${est.paralelo || '-'}</td>
                        <td class="text-center">${est.especialidad || '-'}</td>
                        <td>${est.representante || '-'}</td>
                        <td class="text-center">${est.activo ? '<span class="badge bg-success">Activo</span>' : '<span class="badge bg-danger">Inactivo</span>'}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-info" onclick='verEstudiante(${JSON.stringify(est)})' title="Ver detalles">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-warning" onclick='editarEstudiante(${JSON.stringify(est)})' title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="eliminarEstudiante(${est.id}, '${est.nombres_apellidos}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>`;
            });
            tbody.innerHTML = html;
        }

        function filtrarEstudiantes() {
            const q = document.getElementById('buscador').value.toLowerCase();
            const esp = document.getElementById('filtroEspecialidad').value;
            let base = grupoActivo 
                ? estudiantesData.filter(e => `${e.curso || ''}-${e.paralelo || ''}-${e.especialidad || ''}` === grupoActivo)
                : estudiantesData;
            if (esp && !grupoActivo) {
                base = base.filter(e => e.especialidad === esp);
            }
            const filtrados = base.filter(e =>
                e.nombres_apellidos.toLowerCase().includes(q) ||
                (e.cedula && e.cedula.includes(q)) ||
                (e.numero_matricula && e.numero_matricula.toLowerCase().includes(q)) ||
                (e.curso && e.curso.toLowerCase().includes(q)) ||
                (e.paralelo && e.paralelo.toLowerCase().includes(q))
            );
            renderizarTabla(filtrados);
        }

        function calcularEdad() {
            const fnac = document.getElementById('campoFechaNac').value;
            if (!fnac) { document.getElementById('campoEdad').value = ''; return; }
            const hoy = new Date();
            const nac = new Date(fnac);
            let edad = hoy.getFullYear() - nac.getFullYear();
            const m = hoy.getMonth() - nac.getMonth();
            if (m < 0 || (m === 0 && hoy.getDate() < nac.getDate())) edad--;
            document.getElementById('campoEdad').value = edad;
        }

        function toggleDiscapacidad() {
            const val = document.getElementById('campoDiscapacidad').value;
            document.getElementById('divDiscapacidadTipo').style.display = val === 'SI' ? 'block' : 'none';
        }

        async function buscarEstudianteAnterior(cedula) {
            if (!cedula || document.getElementById('editId').value) return;
            try {
                const res = await fetch(`/api/secretaria/buscar-anteriores?cedula=${encodeURIComponent(cedula)}`);
                const est = await res.json();
                if (est && confirm(`Estudiante encontrado en año ${est.anio_lectivo}. ¿Desea copiar sus datos?`)) {
                    document.getElementById('campoNombre').value = est.nombres_apellidos || '';
                    document.getElementById('campoFechaNac').value = est.fecha_nacimiento ? est.fecha_nacimiento.split('T')[0] : '';
                    if (est.fecha_nacimiento) calcularEdad();
                    document.getElementById('campoSexo').value = est.sexo || 'M';
                    document.getElementById('campoEmail').value = est.email || '';
                    document.getElementById('campoTipoSangre').value = est.tipo_sangre || '';
                    document.getElementById('campoDiscapacidad').value = est.discapacidad || 'NO';
                    document.getElementById('campoDiscapacidadTipo').value = est.discapacidad_tipo || '';
                    toggleDiscapacidad();
                    document.getElementById('campoPais').value = est.pais || 'Ecuador';
                    document.getElementById('campoProvincia').value = est.provincia || '';
                    document.getElementById('campoCiudad').value = est.ciudad || '';
                    document.getElementById('campoParroquia').value = est.parroquia || '';
                    document.getElementById('campoDireccion').value = est.direccion || '';
                    document.getElementById('campoRepresentante').value = est.representante || '';
                    document.getElementById('campoCedulaRep').value = est.cedula_representante || '';
                    document.getElementById('campoParentescoRep').value = est.parentesco_representante || '';
                    document.getElementById('campoTelefonoRep').value = est.telefono_representante || '';
                    document.getElementById('campoEmailRep').value = est.email_representante || '';
                    document.getElementById('campoTrabajoRep').value = est.lugar_trabajo_representante || '';
                    showNotification('Datos del año anterior cargados', 'success');
                }
            } catch (err) {}
        }

        function limpiarFormulario() {
            ['editId','campoCedula','campoNombre','campoFechaNac','campoEdad','campoEmail',
             'campoDiscapacidadTipo','campoPais','campoProvincia','campoCiudad','campoParroquia',
             'campoDireccion','campoRepresentante','campoCedulaRep','campoParentescoRep','campoTelefonoRep',
             'campoEmailRep','campoTrabajoRep'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('campoSexo').value = 'M';
            document.getElementById('campoTipoSangre').value = '';
            document.getElementById('campoDiscapacidad').value = 'NO';
            document.getElementById('campoAnioLectivo').value = aniosLectivos[0] || '2026-2027';
            document.getElementById('campoCurso').value = '';
            document.getElementById('campoParalelo').value = '';
            document.getElementById('campoEspecialidad').value = '';
            document.getElementById('campoPais').value = 'Ecuador';
            document.getElementById('divDiscapacidadTipo').style.display = 'none';
            document.getElementById('campoCedula').disabled = false;
        }

        function abrirModalCrear() {
            limpiarFormulario();
            cargarSelectsCursos();
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-user-plus me-2"></i>Nueva Matricula';
            new bootstrap.Modal(document.getElementById('modalMatricula')).show();
        }

        function abrirModalCrearGrupo(curso, paralelo, especialidad) {
            limpiarFormulario();
            cargarSelectsCursos();
            document.getElementById('campoCurso').value = curso;
            actualizarParalelosYEspecialidades();
            document.getElementById('campoParalelo').value = paralelo;
            if (especialidad && especialidad !== '-') document.getElementById('campoEspecialidad').value = especialidad;
            document.getElementById('modalTitle').innerHTML = `<i class="fas fa-user-plus me-2"></i>Nueva Matricula - ${curso} ${paralelo} ${especialidad || ''}`;
            new bootstrap.Modal(document.getElementById('modalMatricula')).show();
        }

        function cargarSelectsCursos() {
            const selectCurso = document.getElementById('campoCurso');
            const valorActual = selectCurso.value;
            selectCurso.innerHTML = '<option value="">Seleccionar...</option>';
            cursosData.filter(c => c.activo).forEach(curso => {
                const option = document.createElement('option');
                option.value = curso.nombre;
                option.textContent = curso.nombre;
                selectCurso.appendChild(option);
            });
            if (valorActual) selectCurso.value = valorActual;
        }

        function actualizarParalelosYEspecialidades() {
            const nombreCurso = document.getElementById('campoCurso').value;
            const selectParalelo = document.getElementById('campoParalelo');
            const selectEspecialidad = document.getElementById('campoEspecialidad');
            selectParalelo.innerHTML = '<option value="">Seleccionar...</option>';
            selectEspecialidad.innerHTML = '<option value="">Seleccionar...</option>';
            if (!nombreCurso) return;
            const curso = cursosData.find(c => c.nombre === nombreCurso);
            if (!curso) return;
            const pars = (curso.paralelos || 'A,B').split(',').map(p => p.trim()).filter(Boolean);
            pars.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p; opt.textContent = p;
                selectParalelo.appendChild(opt);
            });
            const esps = curso.especialidades ? curso.especialidades.split(',').map(e => e.trim()).filter(Boolean) : [];
            esps.forEach(e => {
                const opt = document.createElement('option');
                opt.value = e; opt.textContent = e;
                selectEspecialidad.appendChild(opt);
            });
        }

        function editarEstudiante(est) {
            limpiarFormulario();
            cargarSelectsCursos();
            document.getElementById('editId').value = est.id;
            document.getElementById('campoCedula').value = est.cedula;
            document.getElementById('campoCedula').disabled = true;
            document.getElementById('campoNombre').value = est.nombres_apellidos;
            document.getElementById('campoFechaNac').value = est.fecha_nacimiento ? est.fecha_nacimiento.split('T')[0] : '';
            if (est.fecha_nacimiento) calcularEdad();
            document.getElementById('campoSexo').value = est.sexo;
            document.getElementById('campoEmail').value = est.email || '';
            document.getElementById('campoTipoSangre').value = est.tipo_sangre || '';
            document.getElementById('campoDiscapacidad').value = est.discapacidad || 'NO';
            document.getElementById('campoDiscapacidadTipo').value = est.discapacidad_tipo || '';
            toggleDiscapacidad();
            document.getElementById('campoPais').value = est.pais || 'Ecuador';
            document.getElementById('campoProvincia').value = est.provincia || '';
            document.getElementById('campoCiudad').value = est.ciudad || '';
            document.getElementById('campoParroquia').value = est.parroquia || '';
            document.getElementById('campoDireccion').value = est.direccion || '';
            document.getElementById('campoRepresentante').value = est.representante || '';
            document.getElementById('campoCedulaRep').value = est.cedula_representante || '';
            document.getElementById('campoParentescoRep').value = est.parentesco_representante || '';
            document.getElementById('campoTelefonoRep').value = est.telefono_representante || '';
            document.getElementById('campoEmailRep').value = est.email_representante || '';
            document.getElementById('campoTrabajoRep').value = est.lugar_trabajo_representante || '';
            document.getElementById('campoAnioLectivo').value = est.anio_lectivo || '2026-2027';
            document.getElementById('campoCurso').value = est.curso || '';
            actualizarParalelosYEspecialidades();
            document.getElementById('campoParalelo').value = est.paralelo || '';
            document.getElementById('campoEspecialidad').value = est.especialidad || '';
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Editar Matricula';
            new bootstrap.Modal(document.getElementById('modalMatricula')).show();
        }

        function verEstudiante(est) {
            let html = '<table class="table table-sm">';
            const campos = [
                ['Matrícula', `<strong>${est.numero_matricula || '-'}</strong>`],
                ['Cédula', est.cedula], ['Nombres', est.nombres_apellidos],
                ['Fecha Nacimiento', est.fecha_nacimiento ? new Date(est.fecha_nacimiento).toLocaleDateString('es-ES') : '-'],
                ['Edad', est.edad || '-'], ['Género', est.sexo === 'M' ? 'Masculino' : 'Femenino'],
                ['Email', est.email || '-'], ['Tipo Sangre', est.tipo_sangre || '-'],
                ['Discapacidad', est.discapacidad || 'NO'], ['Tipo Discapacidad', est.discapacidad_tipo || '-'],
                ['País', est.pais || '-'], ['Provincia', est.provincia || '-'],
                ['Ciudad', est.ciudad || '-'], ['Parroquia', est.parroquia || '-'],
                ['Dirección', est.direccion || '-'],
                ['Representante', est.representante || '-'], ['Cédula Rep.', est.cedula_representante || '-'],
                ['Parentesco', est.parentesco_representante || '-'],
                ['Teléfono Rep.', est.telefono_representante || '-'], ['Email Rep.', est.email_representante || '-'],
                ['Trabajo Rep.', est.lugar_trabajo_representante || '-'],
                ['Año Lectivo', est.anio_lectivo || '-'], ['Curso', est.curso || '-'],
                ['Paralelo', est.paralelo || '-'], ['Especialidad', est.especialidad || '-']
            ];
            campos.forEach(([label, val]) => { html += `<tr><td class="fw-bold" style="width:40%">${label}</td><td>${val}</td></tr>`; });
            html += '</table>';
            document.querySelector('#modalMatricula .modal-body').innerHTML = html;
            document.querySelector('#modalMatricula .modal-header').className = 'modal-header bg-info text-white';
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-id-card me-2"></i>Ficha del Estudiante';
            document.getElementById('btnGuardar').style.display = 'none';
            document.querySelector('#modalMatricula .modal-footer').innerHTML = '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>';
            new bootstrap.Modal(document.getElementById('modalMatricula')).show();
            document.getElementById('modalMatricula').addEventListener('hidden.bs.modal', () => {
                document.querySelector('#modalMatricula .modal-header').className = 'modal-header bg-success text-white';
                document.getElementById('btnGuardar').style.display = '';
                document.querySelector('#modalMatricula .modal-footer').innerHTML = '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success" id="btnGuardar">Guardar Matricula</button>';
            }, { once: true });
        }

        async function guardarEstudiante(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const data = {
                cedula: document.getElementById('campoCedula').value,
                nombres_apellidos: document.getElementById('campoNombre').value,
                sexo: document.getElementById('campoSexo').value,
                fecha_nacimiento: document.getElementById('campoFechaNac').value || null,
                email: document.getElementById('campoEmail').value || null,
                tipo_sangre: document.getElementById('campoTipoSangre').value || null,
                discapacidad: document.getElementById('campoDiscapacidad').value,
                discapacidad_tipo: document.getElementById('campoDiscapacidadTipo').value || null,
                pais: document.getElementById('campoPais').value || null,
                provincia: document.getElementById('campoProvincia').value || null,
                ciudad: document.getElementById('campoCiudad').value || null,
                parroquia: document.getElementById('campoParroquia').value || null,
                direccion: document.getElementById('campoDireccion').value || null,
                representante: document.getElementById('campoRepresentante').value || null,
                cedula_representante: document.getElementById('campoCedulaRep').value || null,
                parentesco_representante: document.getElementById('campoParentescoRep').value || null,
                telefono_representante: document.getElementById('campoTelefonoRep').value || null,
                email_representante: document.getElementById('campoEmailRep').value || null,
                lugar_trabajo_representante: document.getElementById('campoTrabajoRep').value || null,
                anio_lectivo: document.getElementById('campoAnioLectivo').value,
                curso: document.getElementById('campoCurso').value,
                paralelo: document.getElementById('campoParalelo').value,
                especialidad: document.getElementById('campoEspecialidad').value || null
            };
            try {
                let res;
                if (id) {
                    res = await fetch(`/api/secretaria/estudiantes/${id}`, {
                        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
                    });
                } else {
                    res = await fetch('/api/secretaria/estudiantes', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
                    });
                }
                const result = await res.json();
                if (res.ok) {
                    showNotification(id ? 'Matricula actualizada' : 'Estudiante matriculado', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('modalMatricula')).hide();
                    cargarEstudiantes();
                } else {
                    showNotification(result.error || 'Error', 'danger');
                }
            } catch (err) {
                showNotification('Error de conexion', 'danger');
            }
        }

        async function eliminarEstudiante(id, nombre) {
            if (!confirm(`Eliminar la matricula de "${nombre}"?`)) return;
            try {
                const res = await fetch(`/api/secretaria/estudiantes/${id}`, { method: 'DELETE' });
                const result = await res.json();
                if (res.ok) {
                    showNotification('Estudiante eliminado', 'success');
                    cargarEstudiantes();
                } else {
                    showNotification(result.error || 'Error', 'danger');
                }
            } catch (err) {
                showNotification('Error de conexion', 'danger');
            }
        }

        function abrirModalImportar() {
            document.getElementById('formImportar').reset();
            document.getElementById('resultadoImportacion').style.display = 'none';
            new bootstrap.Modal(document.getElementById('modalImportar')).show();
        }

        async function importarExcel(e) {
            e.preventDefault();
            const archivo = document.getElementById('archivoExcel').files[0];
            if (!archivo) return;

            const btn = document.getElementById('btnImportar');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Importando...';

            const formData = new FormData();
            formData.append('archivo', archivo);

            try {
                const res = await fetch('/api/secretaria/importar-excel', {
                    method: 'POST', body: formData
                });
                const result = await res.json();
                const div = document.getElementById('resultadoImportacion');
                div.style.display = 'block';

                if (res.ok) {
                    div.innerHTML = `<div class="alert alert-success">
                        <i class="fas fa-check-circle me-1"></i>${result.message}
                    </div>`;
                    cargarEstudiantes();
                    showNotification(result.message, 'success');
                } else {
                    div.innerHTML = `<div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle me-1"></i>${result.error}
                    </div>`;
                }
            } catch (err) {
                document.getElementById('resultadoImportacion').style.display = 'block';
                document.getElementById('resultadoImportacion').innerHTML = `<div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-1"></i>Error de conexion al importar
                </div>`;
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-upload me-1"></i>Importar';
        }

        async function abrirModalCursos() {
            await cargarCursos();
            renderizarCursos();
            new bootstrap.Modal(document.getElementById('modalCursos')).show();
        }

        function renderizarCursos() {
            const tbody = document.getElementById('cuerpoCursos');
            tbody.innerHTML = '';
            cursosData.forEach(curso => {
                tbody.innerHTML += `
                    <tr>
                        <td class="fw-bold">${curso.nombre}</td>
                        <td>${curso.paralelos || '-'}</td>
                        <td>${curso.especialidades || '-'}</td>
                        <td class="text-center">
                            ${curso.activo ? '<span class="badge bg-success">Activo</span>' : '<span class="badge bg-secondary">Inactivo</span>'}
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm ${curso.activo ? 'btn-warning' : 'btn-success'}" 
                                    onclick="toggleCurso(${curso.id})" title="${curso.activo ? 'Desactivar' : 'Activar'}">
                                <i class="fas fa-${curso.activo ? 'pause' : 'play'}"></i>
                            </button>
                            <button class="btn btn-sm btn-info" onclick='editarCurso(${JSON.stringify(curso)})' title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="eliminarCurso(${curso.id}, '${curso.nombre}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>`;
            });
        }

        async function guardarCurso() {
            const nombre = document.getElementById('campoNombreCurso').value.trim();
            const paralelos = document.getElementById('campoParalelos').value.trim();
            const especialidades = document.getElementById('campoEspecialidades').value.trim();
            if (!nombre) return showNotification('Nombre del curso requerido', 'warning');
            try {
                const res = await fetch('/api/cursos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nombre, paralelos, especialidades })
                });
                const result = await res.json();
                if (res.ok) {
                    showNotification(result.message, 'success');
                    document.getElementById('campoNombreCurso').value = '';
                    document.getElementById('campoParalelos').value = '';
                    document.getElementById('campoEspecialidades').value = '';
                    await cargarCursos();
                    renderizarCursos();
                    renderizarGrupos();
                } else {
                    showNotification(result.error, 'danger');
                }
            } catch (err) {
                showNotification('Error de conexion', 'danger');
            }
        }

        function editarCurso(curso) {
            document.getElementById('campoNombreCurso').value = curso.nombre;
            document.getElementById('campoParalelos').value = curso.paralelos || '';
            document.getElementById('campoEspecialidades').value = curso.especialidades || '';
            document.getElementById('campoNombreCurso').dataset.editId = curso.id;
        }

        async function toggleCurso(id) {
            try {
                await fetch(`/api/cursos/${id}/toggle`, { method: 'PUT' });
                await cargarCursos();
                renderizarCursos();
                renderizarGrupos();
                showNotification('Estado actualizado', 'success');
            } catch (err) {
                showNotification('Error', 'danger');
            }
        }

        async function eliminarCurso(id, nombre) {
            if (!confirm(`Eliminar el curso "${nombre}"?`)) return;
            try {
                await fetch(`/api/cursos/${id}`, { method: 'DELETE' });
                showNotification('Curso eliminado', 'success');
                await cargarCursos();
                renderizarCursos();
                renderizarGrupos();
            } catch (err) {
                showNotification('Error', 'danger');
            }
        }
    </script>
</body>
</html>
