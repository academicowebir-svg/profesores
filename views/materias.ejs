<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Materias - Sistema Academico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="/js/materias.js" defer></script>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-primary text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-book me-2"></i>Ingreso de Materias</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menú</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">
                <div class="d-flex justify-content-between mb-3">
                    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#materiaModal" id="btnNuevo" onclick="abrirModalNuevo()">
                        <i class="fas fa-plus me-1"></i> Nueva Materia
                    </button>
                    <input type="text" class="form-control w-25" placeholder="Buscar por nombre..." id="searchInput" onkeyup="buscarMaterias()">
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Nombre Materia</th>
                                <th>Curso</th>
                                <th>Paralelo</th>
                                <th>Especialidad</th>
                                <th>Horas Semana</th>
                                <th>Profesor</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaMaterias">
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <!-- Modal Materia -->
    <div class="modal fade" id="materiaModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="materiaForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalTitle">Nueva Materia</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="materiaId">
                        <div class="mb-3">
                            <label class="form-label">Nombre de la Materia *</label>
                            <input type="text" class="form-control" id="nombre_materia" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Curso *</label>
                            <input type="text" class="form-control" id="curso" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Paralelo *</label>
                            <input type="text" class="form-control" id="paralelo" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Especialidad</label>
                            <input type="text" class="form-control" id="especialidad">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Horas a la semana</label>
                            <input type="number" class="form-control" id="horas_semana" min="0">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Profesor / Docente</label>
                            <input type="text" class="form-control" id="profesor" placeholder="Nombre del docente">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>