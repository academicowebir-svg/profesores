<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asignacion - Sistema Academico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="/js/grupos.js" defer></script>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-primary text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-user-plus me-2"></i>Asignacion - Asignar Estudiantes a Materias</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menú</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">
                <ul class="nav nav-tabs mb-3" id="asignacionTabs">
                    <li class="nav-item"><a class="nav-link active" href="#" onclick="mostrarTab('asignar')"><i class="fas fa-plus me-1"></i>Asignar Estudiantes</a></li>
                    <li class="nav-item"><a class="nav-link" href="#" onclick="mostrarTab('listar')"><i class="fas fa-list me-1"></i>Listar Asignaciones</a></li>
                </ul>

                <!-- Tab Asignar Estudiantes -->
                <div id="tabAsignar" class="tab-content">
                    <div class="card">
                        <div class="card-header"><i class="fas fa-plus me-1"></i>Escoger Materia y Asignar Estudiantes</div>
                        <div class="card-body">
                            <form id="asignacionForm">
                                <div class="row g-3">
                                    <div class="col-md-5">
                                        <label class="form-label">Seleccionar Materia *</label>
                                        <select class="form-select" id="materiaSeleccion" onchange="cargarEstudiantesMateria()" required>
                                            <option value="">Seleccionar materia...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-7 d-flex align-items-end">
                                        <button type="submit" class="btn btn-success w-100"><i class="fas fa-save me-1"></i>Guardar Asignacion</button>
                                    </div>
                                </div>
                                <hr>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Filtrar por Curso</label>
                                        <select class="form-select form-select-sm" id="filtroCurso" onchange="filtrarEstudiantes()">
                                            <option value="">Todos</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Filtrar por Paralelo</label>
                                        <select class="form-select form-select-sm" id="filtroParalelo" onchange="filtrarEstudiantes()">
                                            <option value="">Todos</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Filtrar por Especialidad</label>
                                        <select class="form-select form-select-sm" id="filtroEspecialidad" onchange="filtrarEstudiantes()">
                                            <option value="">Todos</option>
                                        </select>
                                    </div>
                                </div>
                                <h6>Estudiantes asignados a la materia</h6>
                                <div class="border rounded p-2" style="max-height: 350px; overflow-y: auto;">
                                    <div id="estudiantes_checkboxes" class="row row-cols-1 row-cols-md-2 g-2">
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="seleccionarTodo()">Seleccionar Todo</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="deseleccionarTodo()">Deseleccionar Todo</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Tab Listar Asignaciones -->
                <div id="tabListar" class="tab-content" style="display: none;">
                    <div class="card">
                        <div class="card-header"><i class="fas fa-list me-1"></i>Asignaciones Registradas</div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>#</th>
                                            <th>Materia</th>
                                            <th>Curso</th>
                                            <th>Paralelo</th>
                                            <th>Especialidad</th>
                                            <th>Total Estudiantes</th>
                                            <th class="text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tablaAsignaciones">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>
</body>
</html>