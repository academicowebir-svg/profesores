<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prueba de Diagnostico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <style>
        .nota-input { width: 70px; text-align: center; }
        .total-cell { font-weight: bold; font-size: 1.1em; }
        .desc-no { color: #dc3545; font-weight: bold; }
        .desc-prox { color: #fd7e14; font-weight: bold; }
        .desc-logro { color: #198754; font-weight: bold; }
        .desc-domina { color: #0d6efd; font-weight: bold; }
        .table td { vertical-align: middle; }
        .th-destreza { min-width: 100px; }
    </style>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-primary text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-clipboard-list me-2"></i>Prueba de Diagnostico</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menu</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">

                <div class="card mb-3">
                    <div class="card-header"><i class="fas fa-filter me-1"></i>Seleccionar Materia y Curso</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Materia *</label>
                                <select class="form-select" id="materia_diag" onchange="cargarCursosDiag()">
                                    <option value="">Seleccionar materia...</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Curso *</label>
                                <select class="form-select" id="grupo_diag">
                                    <option value="">Seleccionar curso...</option>
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button class="btn btn-primary w-100" onclick="cargarEstudiantesDiag()">
                                    <i class="fas fa-search me-1"></i>Cargar Estudiantes
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" id="tablaDiagCard" style="display: none;">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-clipboard-check me-1"></i>Diagnostico - <span id="nombreGrupoDiag"></span></span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-success" onclick="agregarDestreza()">
                                <i class="fas fa-plus"></i> Agregar Destreza
                            </button>
                            <button class="btn btn-sm btn-warning" onclick="quitarDestreza()">
                                <i class="fas fa-minus"></i> Quitar Destreza
                            </button>
                            <button class="btn btn-sm btn-primary" onclick="guardarDiagnosticos()">
                                <i class="fas fa-save"></i> Guardar
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm" id="tablaDiag">
                                <thead class="table-primary" id="tablaDiagHead"></thead>
                                <tbody id="tablaDiagBody"></tbody>
                            </table>
                        </div>
                        <div id="noEstudiantes" class="text-center text-muted py-4" style="display:none;">
                            <i class="fas fa-users-slash fa-3x mb-3"></i>
                            <p>No hay estudiantes asignados para este curso y materia.</p>
                        </div>

                        <div class="mt-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card border-primary">
                                        <div class="card-body text-center">
                                            <h6 class="card-title text-muted">Leyenda de Calificaciones</h6>
                                            <div class="d-flex flex-column gap-1">
                                                <span class="desc-domina"><i class="fas fa-star me-1"></i>9.00 - 10.00: Domina los aprendizajes</span>
                                                <span class="desc-logro"><i class="fas fa-check-circle me-1"></i>7.00 - 8.99: Alcanza los aprendizajes</span>
                                                <span class="desc-prox"><i class="fas fa-hourglass-half me-1"></i>4.01 - 6.99: Proximos a alcanzar los aprendizajes</span>
                                                <span class="desc-no"><i class="fas fa-times-circle me-1"></i>0.00 - 4.00: No alcanza los aprendizajes</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-info">
                                        <div class="card-body text-center">
                                            <h6 class="card-title text-muted">Resumen del Grupo</h6>
                                            <p class="mb-1">Total estudiantes: <strong id="totalEstudiantes">0</strong></p>
                                            <p class="mb-1">Domina: <strong id="countDomina" class="text-primary">0</strong></p>
                                            <p class="mb-1">Alcanza: <strong id="countAlcanza" class="text-success">0</strong></p>
                                            <p class="mb-1">Proximos: <strong id="countProximos" class="text-warning">0</strong></p>
                                            <p class="mb-0">No alcanza: <strong id="countNoAlcanza" class="text-danger">0</strong></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <script>
        let estudiantesDiag = [];
        let diagnosticosExistentes = [];
        let numDestrezas = 3;
        let materiaInfo = {};

        function getDescripcion(total) {
            if (total >= 9.00) return 'Domina los aprendizajes';
            if (total >= 7.00) return 'Alcanza los aprendizajes';
            if (total >= 4.01) return 'Proximos a alcanzar los aprendizajes';
            return 'No alcanza los aprendizajes';
        }

        function getDescClass(total) {
            if (total >= 9.00) return 'desc-domina';
            if (total >= 7.00) return 'desc-logro';
            if (total >= 4.01) return 'desc-prox';
            return 'desc-no';
        }

        async function cargarMateriasDiag() {
            const res = await fetch('/api/diagnostico/materias');
            const materias = await res.json();
            const select = document.getElementById('materia_diag');
            select.innerHTML = '<option value="">Seleccionar materia...</option>';
            materias.forEach(m => {
                const opt = document.createElement('option');
                opt.value = JSON.stringify({ curso: m.curso, paralelo: m.paralelo, materia_id: m.id, nombre: m.nombre_materia });
                opt.textContent = `${m.nombre_materia} - ${m.curso} ${m.paralelo}`;
                select.appendChild(opt);
            });
        }

        function cargarCursosDiag() {
            document.getElementById('grupo_diag').innerHTML = '<option value="">Seleccionar curso...</option>';
            document.getElementById('tablaDiagCard').style.display = 'none';
        }

        async function cargarEstudiantesDiag() {
            const val = document.getElementById('materia_diag').value;
            if (!val) return alert('Seleccione una materia');

            materiaInfo = JSON.parse(val);
            const { curso, paralelo, materia_id } = materiaInfo;

            document.getElementById('nombreGrupoDiag').textContent = `${materiaInfo.nombre} - ${curso} ${paralelo}`;

            const res = await fetch(`/api/diagnostico/curso/${curso}/paralelo/${paralelo}/materia/${materia_id}/estudiantes`);
            estudiantesDiag = await res.json();

            if (estudiantesDiag.length === 0) {
                document.getElementById('tablaDiagCard').style.display = 'block';
                document.getElementById('tablaDiagBody').innerHTML = '';
                document.getElementById('tablaDiagHead').innerHTML = '';
                document.getElementById('noEstudiantes').style.display = 'block';
                return;
            }

            document.getElementById('noEstudiantes').style.display = 'none';

            const diagRes = await fetch(`/api/diagnostico/curso/${curso}/paralelo/${paralelo}/materia/${materia_id}/diagnosticos`);
            diagnosticosExistentes = await diagRes.json();

            if (diagnosticosExistentes.length > 0 && diagnosticosExistentes[0].destrezas) {
                const primerDiag = typeof diagnosticosExistentes[0].destrezas === 'string'
                    ? JSON.parse(diagnosticosExistentes[0].destrezas)
                    : diagnosticosExistentes[0].destrezas;
                numDestrezas = primerDiag.length;
            }

            renderTablaDiag();
            document.getElementById('tablaDiagCard').style.display = 'block';
        }

        function renderTablaDiag() {
            const thead = document.getElementById('tablaDiagHead');
            const tbody = document.getElementById('tablaDiagBody');

            let headerHtml = '<tr><th>#</th><th>Estudiante</th>';
            for (let i = 1; i <= numDestrezas; i++) {
                headerHtml += `<th class="th-destreza">Destreza ${i}<br><small class="text-muted">(0-10)</small></th>`;
            }
            headerHtml += '<th>Total</th><th>Descripcion</th></tr>';
            thead.innerHTML = headerHtml;

            let bodyHtml = '';
            let countD = 0, countA = 0, countP = 0, countN = 0;

            estudiantesDiag.forEach((est, idx) => {
                const diagExistente = diagnosticosExistentes.find(d => d.estudiante_id === est.id);
                let destrezasExistentes = [];
                if (diagExistente && diagExistente.destrezas) {
                    destrezasExistentes = typeof diagExistente.destrezas === 'string'
                        ? JSON.parse(diagExistente.destrezas)
                        : diagExistente.destrezas;
                }

                let total = 0;
                if (destrezasExistentes.length > 0) {
                    total = destrezasExistentes.reduce((sum, d) => sum + (parseFloat(d) || 0), 0) / destrezasExistentes.length;
                }
                total = parseFloat(total.toFixed(2));
                const desc = getDescripcion(total);
                const descClass = getDescClass(total);

                if (total >= 9.00) countD++;
                else if (total >= 7.00) countA++;
                else if (total >= 4.01) countP++;
                else if (total > 0) countN++;

                bodyHtml += `<tr>
                    <td>${idx + 1}</td>
                    <td>${est.nombres_apellidos}</td>`;

                for (let i = 0; i < numDestrezas; i++) {
                    const val = destrezasExistentes[i] !== undefined && destrezasExistentes[i] !== null ? destrezasExistentes[i] : '';
                    bodyHtml += `<td><input type="number" class="form-control nota-input" min="0" max="10" step="0.01"
                        value="${val}"
                        data-estudiante="${est.id}" data-idx="${i}"
                        oninput="calcularTotal(this)"></td>`;
                }

                bodyHtml += `<td class="total-cell total-cell-${est.id}">${total > 0 ? total.toFixed(2) : '-'}</td>
                    <td class="${descClass} desc-cell-${est.id}">${total > 0 ? desc : '-'}</td></tr>`;
            });

            tbody.innerHTML = bodyHtml;

            document.getElementById('totalEstudiantes').textContent = estudiantesDiag.length;
            document.getElementById('countDomina').textContent = countD;
            document.getElementById('countAlcanza').textContent = countA;
            document.getElementById('countProximos').textContent = countP;
            document.getElementById('countNoAlcanza').textContent = countN;
        }

        function calcularTotal(input) {
            const row = input.closest('tr');
            const inputs = row.querySelectorAll('.nota-input');
            let suma = 0;
            let count = 0;
            inputs.forEach(inp => {
                const val = parseFloat(inp.value);
                if (!isNaN(val)) {
                    suma += val;
                    count++;
                }
            });

            const estId = input.dataset.estudiante;
            const totalCell = row.querySelector(`.total-cell-${estId}`);
            const descCell = row.querySelector(`.desc-cell-${estId}`);

            if (count > 0) {
                const promedio = suma / count;
                const total = parseFloat(promedio.toFixed(2));
                totalCell.textContent = total.toFixed(2);
                descCell.textContent = getDescripcion(total);
                descCell.className = `total-cell ${getDescClass(total)} desc-cell-${estId}`;
            } else {
                totalCell.textContent = '-';
                descCell.textContent = '-';
                descCell.className = `total-cell desc-cell-${estId}`;
            }

            actualizarResumen();
        }

        function actualizarResumen() {
            let countD = 0, countA = 0, countP = 0, countN = 0;
            estudiantesDiag.forEach(est => {
                const row = document.querySelector(`tr input[data-estudiante="${est.id}"]`)?.closest('tr');
                if (!row) return;
                const totalText = row.querySelector(`.total-cell-${est.id}`)?.textContent;
                if (!totalText || totalText === '-') return;
                const total = parseFloat(totalText);
                if (total >= 9.00) countD++;
                else if (total >= 7.00) countA++;
                else if (total >= 4.01) countP++;
                else countN++;
            });
            document.getElementById('countDomina').textContent = countD;
            document.getElementById('countAlcanza').textContent = countA;
            document.getElementById('countProximos').textContent = countP;
            document.getElementById('countNoAlcanza').textContent = countN;
        }

        function agregarDestreza() {
            numDestrezas++;
            renderTablaDiag();
        }

        function quitarDestreza() {
            if (numDestrezas <= 1) return alert('Debe haber al menos una destreza');
            numDestrezas--;
            renderTablaDiag();
        }

        async function guardarDiagnosticos() {
            const diagnosticos = [];

            estudiantesDiag.forEach(est => {
                const inputs = document.querySelectorAll(`input[data-estudiante="${est.id}"]`);
                const destrezas = [];
                inputs.forEach(inp => {
                    const val = inp.value.trim();
                    destrezas.push(val !== '' ? parseFloat(val) : null);
                });

                const valoresValidos = destrezas.filter(d => d !== null);
                if (valoresValidos.length === 0) return;

                const suma = destrezas.reduce((sum, d) => sum + (d || 0), 0);
                const total = parseFloat((suma / destrezas.length).toFixed(2));

                diagnosticos.push({
                    estudiante_id: est.id,
                    materia_id: materiaInfo.materia_id,
                    curso: materiaInfo.curso,
                    paralelo: materiaInfo.paralelo,
                    destrezas: destrezas,
                    total: total
                });
            });

            if (diagnosticos.length === 0) {
                return alert('Ingrese al menos una nota para guardar');
            }

            try {
                const res = await fetch('/api/diagnostico/guardar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ diagnosticos })
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    cargarEstudiantesDiag();
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (err) {
                alert('Error al guardar: ' + err.message);
            }
        }

        document.addEventListener('DOMContentLoaded', cargarMateriasDiag);
    </script>
</body>
</html>
