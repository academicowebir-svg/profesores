<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prueba de Diagnostico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <style>
        .table td { vertical-align: middle; }
        .nota-input { width: 80px; text-align: center; }
    </style>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-primary text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-clipboard-list me-2"></i>Prueba de Diagnostico</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menu</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">

                <div class="card mb-3">
                    <div class="card-header"><i class="fas fa-filter me-1"></i>Seleccionar Materia y Curso</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Materia *</label>
                                <select class="form-select" id="materia_diag" onchange="cargarCursosDiag()">
                                    <option value="">Seleccionar materia...</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Curso *</label>
                                <select class="form-select" id="grupo_diag" onchange="cargarEstudiantesDiag()">
                                    <option value="">Seleccionar curso...</option>
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button class="btn btn-primary w-100" onclick="cargarEstudiantesDiag()">
                                    <i class="fas fa-search me-1"></i>Cargar Estudiantes
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" id="tablaDiagCard" style="display: none;">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Notas de Diagnostico - <span id="nombreGrupoDiag"></span></span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-success" onclick="agregarColumnaDiag()">
                                <i class="fas fa-plus"></i> Agregar Prueba
                            </button>
                            <button class="btn btn-sm btn-primary" onclick="guardarNotasDiag()">
                                <i class="fas fa-save"></i> Guardar
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm" id="tablaDiag">
                                <thead class="table-primary" id="tablaDiagHead">
                                </thead>
                                <tbody id="tablaDiagBody">
                                </tbody>
                            </table>
                        </div>
                        <div id="noEstudiantes" class="text-center text-muted py-4" style="display:none;">
                            <i class="fas fa-users-slash fa-3x mb-3"></i>
                            <p>No hay estudiantes asignados para este curso y materia.</p>
                        </div>
                    </div>
                </div>

            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <script>
        let estudiantesDiag = [];
        let notasDiag = [];
        let columnasDiag = [];

        async function cargarMateriasDiag() {
            const res = await fetch('/api/diagnostico/materias');
            const materias = await res.json();
            const select = document.getElementById('materia_diag');
            select.innerHTML = '<option value="">Seleccionar materia...</option>';
            materias.forEach(m => {
                const opt = document.createElement('option');
                opt.value = JSON.stringify({ curso: m.curso, paralelo: m.paralelo, materia_id: m.id });
                opt.textContent = `${m.nombre_materia} - ${m.curso} ${m.paralelo}`;
                select.appendChild(opt);
            });
        }

        function cargarCursosDiag() {
            document.getElementById('grupo_diag').innerHTML = '<option value="">Seleccionar curso...</option>';
            document.getElementById('tablaDiagCard').style.display = 'none';
        }

        async function cargarEstudiantesDiag() {
            const val = document.getElementById('materia_diag').value;
            if (!val) return alert('Seleccione una materia');

            const { curso, paralelo, materia_id } = JSON.parse(val);
            const grupoSel = document.getElementById('grupo_diag').value || `${curso}-${paralelo}`;

            document.getElementById('nombreGrupoDiag').textContent = `${curso} ${paralelo}`;

            const res = await fetch(`/api/diagnostico/curso/${curso}/paralelo/${paralelo}/materia/${materia_id}/estudiantes`);
            estudiantesDiag = await res.json();

            if (estudiantesDiag.length === 0) {
                document.getElementById('tablaDiagCard').style.display = 'block';
                document.getElementById('tablaDiagBody').innerHTML = '';
                document.getElementById('tablaDiagHead').innerHTML = '';
                document.getElementById('noEstudiantes').style.display = 'block';
                return;
            }

            document.getElementById('noEstudiantes').style.display = 'none';

            const notasRes = await fetch(`/api/diagnostico/grupo/${estudiantesDiag[0].grupo_id}/todas`);
            const notasData = await notasRes.json();
            notasDiag = notasData.notas || [];

            const indicesExistentes = [...new Set(notasDiag.map(n => n.indice))].sort((a, b) => a - b);
            if (indicesExistentes.length === 0) {
                columnasDiag = [0];
            } else {
                columnasDiag = indicesExistentes;
            }

            renderTablaDiag();
            document.getElementById('tablaDiagCard').style.display = 'block';
        }

        function renderTablaDiag() {
            const thead = document.getElementById('tablaDiagHead');
            const tbody = document.getElementById('tablaDiagBody');

            let headerHtml = '<tr><th>Estudiante</th><th>Cedula</th>';
            columnasDiag.forEach((idx, i) => {
                headerHtml += `<th>Prueba ${i + 1}<br><small class="text-muted"><input type="text" class="form-control form-control-sm" style="width:100px" placeholder="Nombre" id="nombre_diag_${idx}" value=""></small></th>`;
            });
            headerHtml += '</tr>';
            thead.innerHTML = headerHtml;

            let bodyHtml = '';
            estudiantesDiag.forEach(est => {
                bodyHtml += `<tr><td>${est.nombres_apellidos}</td><td>${est.cedula}</td>`;
                columnasDiag.forEach(idx => {
                    const notaExistente = notasDiag.find(n => n.estudiante_id === est.id && n.indice === idx);
                    const valor = notaExistente && notaExistente.nota !== null ? notaExistente.nota : '';
                    bodyHtml += `<td><input type="number" class="form-control nota-input" min="0" max="20" step="0.01"
                        value="${valor}"
                        data-estudiante="${est.id}" data-grupo="${est.grupo_id}" data-indice="${idx}"></td>`;
                });
                bodyHtml += '</tr>';
            });
            tbody.innerHTML = bodyHtml;
        }

        function agregarColumnaDiag() {
            const nuevoIdx = columnasDiag.length > 0 ? Math.max(...columnasDiag) + 1 : 0;
            columnasDiag.push(nuevoIdx);
            renderTablaDiag();
        }

        async function guardarNotasDiag() {
            const inputs = document.querySelectorAll('.nota-input');
            const notas = [];

            inputs.forEach(inp => {
                const val = inp.value.trim();
                if (val !== '') {
                    notas.push({
                        grupo_id: parseInt(inp.dataset.grupo),
                        nota: parseFloat(val),
                        indice: parseInt(inp.dataset.indice),
                        comentario: null
                    });
                }
            });

            if (notas.length === 0) {
                return alert('Ingrese al menos una nota para guardar');
            }

            try {
                const res = await fetch('/api/diagnostico/guardar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ notas })
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    cargarEstudiantesDiag();
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (err) {
                alert('Error al guardar: ' + err.message);
            }
        }

        document.addEventListener('DOMContentLoaded', cargarMateriasDiag);
    </script>
</body>
</html>
